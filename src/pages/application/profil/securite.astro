---
import LayoutFooter from "../../../layouts/Layout-footer.astro";
---

<LayoutFooter>
    <div class="bg-[#f8f5f0] min-h-screen pb-32 font-sans px-6 pt-8 md:pt-12">
        <!-- En-tête -->
        <div class="flex items-center mb-8 max-w-2xl mx-auto">
            <a
                href="/application/profil"
                class="text-slate-900 bg-white p-2.5 rounded-full shadow-sm hover:bg-slate-100 transition-colors"
            >
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="h-6 w-6"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    stroke-width="2"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
                </svg>
            </a>
            <h1 class="text-xl md:text-2xl font-bold ml-4 text-slate-900">
                Sécurité et connexion
            </h1>
        </div>

        <!-- Conteneur Principal -->
        <div
            class="max-w-2xl mx-auto bg-white p-6 md:p-10 rounded-2xl shadow-sm border border-slate-100"
        >
            <p class="text-slate-500 mb-8 text-sm md:text-base">
                Gère la sécurité de ton compte. Tu peux modifier ton mot de
                passe ou te déconnecter de cet appareil.
            </p>

            <!-- SECTION : CHANGER DE MOT DE PASSE -->
            <h2
                class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-4"
            >
                Modifier le mot de passe
            </h2>

            <form id="form-mdp" class="flex flex-col gap-5">
                <!-- Mot de passe actuel avec bouton Oeil -->
                <div class="flex flex-col gap-2">
                    <label
                        for="oldPassword"
                        class="text-sm font-bold text-slate-700 ml-1"
                        >Mot de passe actuel</label
                    >
                    <div class="relative">
                        <input
                            type="password"
                            id="oldPassword"
                            required
                            placeholder="Tape ton mot de passe actuel..."
                            style="padding-left: 20px;"
                            class="w-full bg-[#f8f5f0] border border-slate-200 rounded-xl pr-12 py-3.5 outline-none focus:border-[#a40d1a] transition-all"
                        />
                        <button
                            type="button"
                            class="absolute inset-y-0 right-0 pr-4 flex items-center text-slate-400 hover:text-[#a40d1a] transition-colors btn-toggle-mdp"
                            data-cible="oldPassword"
                        >
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                fill="none"
                                viewBox="0 0 24 24"
                                stroke-width="2"
                                stroke="currentColor"
                                class="w-5 h-5"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    d="M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178z"
                                ></path>
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                            </svg>
                        </button>
                    </div>
                </div>

                <!-- Grille pour les nouveaux mots de passe -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                    <div class="flex flex-col gap-2">
                        <label
                            for="newPassword"
                            class="text-sm font-bold text-slate-700 ml-1"
                            >Nouveau mot de passe</label
                        >
                        <div class="relative">
                            <input
                                type="password"
                                id="newPassword"
                                required
                                minlength="8"
                                placeholder="8 caractères min."
                                style="padding-left: 20px;"
                                class="w-full bg-[#f8f5f0] border border-slate-200 rounded-xl pr-12 py-3.5 outline-none focus:border-[#a40d1a] transition-all"
                            />
                            <button
                                type="button"
                                class="absolute inset-y-0 right-0 pr-4 flex items-center text-slate-400 hover:text-[#a40d1a] transition-colors btn-toggle-mdp"
                                data-cible="newPassword"
                            >
                                <svg
                                    xmlns="http://www.w3.org/2000/svg"
                                    fill="none"
                                    viewBox="0 0 24 24"
                                    stroke-width="2"
                                    stroke="currentColor"
                                    class="w-5 h-5"
                                >
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        d="M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178z"
                                    ></path>
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"
                                    ></path>
                                </svg>
                            </button>
                        </div>
                    </div>

                    <div class="flex flex-col gap-2">
                        <label
                            for="confirmPassword"
                            class="text-sm font-bold text-slate-700 ml-1"
                            >Confirmer le nouveau mot de passe</label
                        >
                        <div class="relative">
                            <input
                                type="password"
                                id="confirmPassword"
                                required
                                minlength="8"
                                placeholder="Confirme le mot de passe"
                                style="padding-left: 20px;"
                                class="w-full bg-[#f8f5f0] border border-slate-200 rounded-xl pr-12 py-3.5 outline-none focus:border-[#a40d1a] transition-all"
                            />
                            <button
                                type="button"
                                class="absolute inset-y-0 right-0 pr-4 flex items-center text-slate-400 hover:text-[#a40d1a] transition-colors btn-toggle-mdp"
                                data-cible="confirmPassword"
                            >
                                <svg
                                    xmlns="http://www.w3.org/2000/svg"
                                    fill="none"
                                    viewBox="0 0 24 24"
                                    stroke-width="2"
                                    stroke="currentColor"
                                    class="w-5 h-5"
                                >
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        d="M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178z"
                                    ></path>
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"
                                    ></path>
                                </svg>
                            </button>
                        </div>
                    </div>
                </div>

                <!-- BOUTON ENREGISTRER (Centré et plus large) -->
                <div class="mt-6 flex justify-center">
                    <button
                        type="submit"
                        id="btn-submit"
                        class="bg-[#a40d1a] hover:bg-red-800 text-white px-12 py-3.5 rounded-xl font-bold shadow-md transition-all active:scale-95 whitespace-nowrap"
                    >
                        Mettre à jour le mot de passe
                    </button>
                </div>
            </form>

            <hr class="my-10 border-slate-100" />

            <!-- SECTION : DÉCONNEXION -->
            <h2
                class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-4"
            >
                Session active
            </h2>

            <button
                type="button"
                id="btn-deconnexion"
                class="bg-white border-2 border-slate-200 hover:border-slate-300 hover:bg-slate-50 text-slate-700 px-6 py-3.5 rounded-xl font-bold w-full transition-all active:scale-95 flex justify-center items-center gap-3"
            >
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="h-5 w-5 text-slate-500 shrink-0"
                    style="width: 20px; height: 20px; min-width: 20px;"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    stroke-width="2"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"
                    ></path>
                </svg>
                <span>Se déconnecter</span>
            </button>
        </div>
    </div>
</LayoutFooter>

<script>
    import PocketBase from "pocketbase";
    const pb = new PocketBase("https://tacita-pb.charlottemettetal.fr:443");

    document.addEventListener("DOMContentLoaded", () => {
        // Sécurité de la page
        if (!pb.authStore.isValid) {
            window.location.href = "/application/profil/connexion";
            return;
        }

        // --- 0. GESTION DES BOUTONS "OEIL" POUR AFFICHER/CACHER LE MOT DE PASSE ---
        const toggleButtons = document.querySelectorAll(".btn-toggle-mdp");

        toggleButtons.forEach((btn) => {
            btn.addEventListener("click", () => {
                // On récupère l'ID du champ correspondant au bouton cliqué
                const inputId = btn.getAttribute("data-cible");
                if (!inputId) return;

                const inputElement = document.getElementById(
                    inputId,
                ) as HTMLInputElement;

                // On inverse le type (password devient text, et inversement)
                if (inputElement.type === "password") {
                    inputElement.type = "text";
                    btn.classList.add("text-[#a40d1a]"); // L'icône devient rouge quand le texte est visible
                } else {
                    inputElement.type = "password";
                    btn.classList.remove("text-[#a40d1a]"); // Retour à la couleur grise
                }
            });
        });

        // --- 1. GESTION DU MOT DE PASSE ---
        const formMdp = document.getElementById("form-mdp");
        const btnSubmit = document.getElementById("btn-submit");

        formMdp?.addEventListener("submit", async (e) => {
            e.preventDefault();

            const oldPassword = (
                document.getElementById("oldPassword") as HTMLInputElement
            ).value;
            const newPassword = (
                document.getElementById("newPassword") as HTMLInputElement
            ).value;
            const confirmPassword = (
                document.getElementById("confirmPassword") as HTMLInputElement
            ).value;

            // Vérification simple avant d'envoyer
            if (newPassword !== confirmPassword) {
                alert("Les nouveaux mots de passe ne correspondent pas !");
                return;
            }

            if (btnSubmit) btnSubmit.textContent = "Mise à jour en cours...";

            try {
                const userId = pb.authStore.model?.id;

                await pb.collection("users").update(userId, {
                    oldPassword: oldPassword,
                    password: newPassword,
                    passwordConfirm: confirmPassword,
                });

                alert("Ton mot de passe a été mis à jour avec succès !");
                (formMdp as HTMLFormElement).reset(); // On vide le formulaire

                // On remet tous les champs en mode "caché" par sécurité
                document
                    .querySelectorAll('input[type="text"]')
                    .forEach((input) => {
                        if (input.id.includes("Password"))
                            (input as HTMLInputElement).type = "password";
                    });
                toggleButtons.forEach((btn) =>
                    btn.classList.remove("text-[#a40d1a]"),
                );
            } catch (error) {
                console.error("Erreur :", error);
                alert(
                    "Erreur ! Vérifie que ton mot de passe actuel est bien correct.",
                );
            } finally {
                if (btnSubmit)
                    btnSubmit.textContent = "Mettre à jour le mot de passe";
            }
        });

        // --- 2. GESTION DE LA DÉCONNEXION ---
        const btnDeconnexion = document.getElementById("btn-deconnexion");

        btnDeconnexion?.addEventListener("click", () => {
            const confirmation = confirm(
                "Veux-tu vraiment te déconnecter de Tacita ?",
            );

            if (confirmation) {
                pb.authStore.clear();
                window.location.href = "/application/profil/connexion";
            }
        });
    });
</script>
