---
import LayoutAppli from "../../../layouts/Layout-appli.astro";
import { getPseudo } from "../../../../backend/backend.mjs";

const Utilisateur = await getPseudo();
---

<LayoutAppli>
    <div
        class="bg-[#f8f5f0] min-h-screen flex flex-col pt-12 px-6 pb-20 items-center"
    >
        <div class="w-full max-w-md flex items-center mb-6">
            <a
                href="/application/profil"
                class="text-slate-900 bg-white p-2.5 rounded-full shadow-sm hover:bg-slate-50 transition-colors"
            >
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="h-6 w-6"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    stroke-width="2"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
                </svg>
            </a>
            <h1 class="text-2xl font-bold ml-4 text-slate-900">
                Nous Contacter
            </h1>
        </div>

        <p class="text-slate-500 font-medium text-center mb-8 max-w-sm">
            Un bug ? Une suggestion pour Tacita ? Écris-nous directement via ce
            formulaire !
        </p>

        <form
            id="form-contact"
            class="bg-white p-8 rounded-3xl shadow-sm border-2 border-slate-100 w-full max-w-md flex flex-col gap-6"
        >
            <div class="flex flex-col gap-2">
                <label for="contact-nom" class="font-bold text-slate-700"
                    >Ton Pseudo</label
                >
                <input
                    type="text"
                    id="contact-nom"
                    value={Utilisateur?.pseudo || ""}
                    class="p-4 rounded-xl border-2 border-slate-200 focus:border-red-400 outline-none transition-colors font-semibold text-slate-800"
                    required
                />
            </div>

            <div class="flex flex-col gap-2">
                <label for="contact-email" class="font-bold text-slate-700"
                    >Ton Email</label
                >
                <input
                    type="email"
                    id="contact-email"
                    value={Utilisateur?.email || ""}
                    class="p-4 rounded-xl border-2 border-slate-200 focus:border-red-400 outline-none transition-colors font-semibold text-slate-800"
                    required
                />
            </div>

            <div class="flex flex-col gap-2">
                <label for="contact-message" class="font-bold text-slate-700"
                    >Ton Message</label
                >
                <textarea
                    id="contact-message"
                    rows="5"
                    class="p-4 rounded-xl border-2 border-slate-200 focus:border-red-400 outline-none resize-none transition-colors font-medium text-slate-700"
                    placeholder="Dis-nous tout..."
                    required></textarea>
            </div>

            <button
                type="submit"
                id="btn-envoyer"
                class="mt-4 bg-slate-900 hover:bg-slate-800 text-white font-bold text-lg py-4 rounded-xl transition-all shadow-md"
            >
                Envoyer le message
            </button>

            <p
                id="message-contact-info"
                class="text-center font-bold text-sm hidden"
            >
            </p>
        </form>
    </div>
</LayoutAppli>

<script>
    import PocketBase from "pocketbase";

    function initialiserPageContact() {
        const pb = new PocketBase("https://tacita-pb.charlottemettetal.fr");
        const form = document.getElementById("form-contact");
        const btn = document.getElementById("btn-envoyer");
        const msg = document.getElementById("message-contact-info");

        if (!form || !btn || !msg) return;

        form.addEventListener("submit", async (e) => {
            e.preventDefault();

            const nom = (
                document.getElementById("contact-nom") as HTMLInputElement
            ).value;
            const email = (
                document.getElementById("contact-email") as HTMLInputElement
            ).value;
            const message = (
                document.getElementById(
                    "contact-message",
                ) as HTMLTextAreaElement
            ).value;

            btn.textContent = "Envoi en cours...";
            btn.classList.add("opacity-50", "pointer-events-none");

            try {
                const data = {
                    nom: nom,
                    email: email,
                    message: message,
                    utilisateur_id: pb.authStore.model
                        ? pb.authStore.model.id
                        : "Non connecté",
                };

                await pb.collection("messages_contact").create(data);

                msg.textContent = "Message envoyé avec succès ! 🚀";
                msg.className =
                    "text-center font-bold text-sm block mt-2 text-green-500";

                (
                    document.getElementById(
                        "contact-message",
                    ) as HTMLTextAreaElement
                ).value = "";

                btn.textContent = "Envoyer un autre message";
                btn.classList.remove("opacity-50", "pointer-events-none");
            } catch (error) {
                console.error(error);
                msg.textContent = "Erreur lors de l'envoi. Réessaie plus tard.";
                msg.className =
                    "text-center font-bold text-sm block mt-2 text-red-500";

                btn.textContent = "Envoyer le message";
                btn.classList.remove("opacity-50", "pointer-events-none");
            }
        });
    }

    document.addEventListener("DOMContentLoaded", initialiserPageContact);
    document.addEventListener("astro:page-load", initialiserPageContact);
</script>
