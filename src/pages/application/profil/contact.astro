---
import LayoutFooter from "../../../layouts/Layout-footer.astro";
---

<LayoutFooter>
    <div class="bg-[#f8f5f0] min-h-screen pb-32 font-sans px-6 pt-8 md:pt-12">
        <div class="flex items-center mb-8 max-w-2xl mx-auto">
            <a
                href="/application/profil"
                class="text-slate-900 bg-white p-1.5 rounded-full shadow-sm hover:bg-slate-100 transition-colors"
            >
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="h-5 w-5"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    stroke-width="2"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
                </svg>
            </a>
        </div>

        <div
            class="max-w-2xl mx-auto bg-white p-6 md:p-10 rounded-3xl shadow-sm border border-slate-100"
        >
            <h1
                class="text-2xl md:text-3xl font-medium text-slate-900 mb-8 leading-tight"
            >
                Contactez-nous en cas de problème
            </h1>

            <form id="form-contact" class="flex flex-col gap-6">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div class="flex flex-col gap-2">
                        <label
                            for="prenom"
                            class="text-sm font-medium text-slate-700 ml-1"
                            >Prénom</label
                        >

                        <input
                            type="text"
                            id="prenom"
                            required
                            style="padding-left: 16px;"
                            class="w-full bg-white border border-slate-300 rounded-xl pr-4 py-3 outline-none focus:border-[#a40d1a] focus:ring-1 focus:ring-[#a40d1a] transition-all"
                        />
                    </div>

                    <div class="flex flex-col gap-2">
                        <label
                            for="nom"
                            class="text-sm font-medium text-slate-700 ml-1"
                            >Nom</label
                        >

                        <input
                            type="text"
                            id="nom"
                            required
                            style="padding-left: 16px;"
                            class="w-full bg-white border border-slate-300 rounded-xl pr-4 py-3 outline-none focus:border-[#a40d1a] focus:ring-1 focus:ring-[#a40d1a] transition-all"
                        />
                    </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div class="flex flex-col gap-2">
                        <label
                            for="telephone"
                            class="text-sm font-medium text-slate-700 ml-1"
                            >Téléphone</label
                        >
                        <input
                            type="tel"
                            id="telephone"
                            style="padding-left: 16px;"
                            class="w-full bg-white border border-slate-300 rounded-xl pr-4 py-3 outline-none focus:border-[#a40d1a] focus:ring-1 focus:ring-[#a40d1a] transition-all"
                        />
                    </div>

                    <div class="flex flex-col gap-2">
                        <label
                            for="email"
                            class="text-sm font-medium text-slate-700 ml-1"
                            >E-mail</label
                        >
                        <input
                            type="email"
                            id="email"
                            required
                            style="padding-left: 16px;"
                            class="w-full bg-slate-50 border border-slate-200 text-slate-500 rounded-xl pr-4 py-3 outline-none cursor-not-allowed"
                            readonly
                        />
                    </div>
                </div>

                <div class="flex flex-col gap-2">
                    <label
                        for="objet"
                        class="text-sm font-medium text-slate-700 ml-1"
                        >Objet</label
                    >
                    <input
                        type="text"
                        id="objet"
                        required
                        style="padding-left: 16px;"
                        class="w-full bg-white border border-slate-300 rounded-xl pr-4 py-3 outline-none focus:border-[#a40d1a] focus:ring-1 focus:ring-[#a40d1a] transition-all"
                    />
                </div>

                <div class="flex flex-col gap-2">
                    <label
                        for="message"
                        class="text-sm font-medium text-slate-700 ml-1"
                        >Message</label
                    >
                    <textarea
                        id="message"
                        required
                        rows="5"
                        style="padding-left: 16px; padding-top: 12px;"
                        class="w-full bg-white border border-slate-300 rounded-xl pr-4 pb-3 outline-none focus:border-[#a40d1a] focus:ring-1 focus:ring-[#a40d1a] transition-all resize-none"
                    ></textarea>
                </div>

                <div class="mt-4 flex justify-center">
                    <button
                        type="submit"
                        id="btn-submit"
                        class="bg-[#a40d1a] hover:bg-red-800 text-white px-12 py-3 rounded-xl font-medium shadow-md transition-all active:scale-95"
                    >
                        Envoyer
                    </button>
                </div>
            </form>
        </div>
    </div>
</LayoutFooter>

<script>
    import PocketBase from "pocketbase";
    const pb = new PocketBase("https://tacita-pb.charlottemettetal.fr:443");

    document.addEventListener("DOMContentLoaded", async () => {
        if (!pb.authStore.isValid) {
            window.location.href = "/application/profil/connexion";
            return;
        }

        const prenomInput = document.getElementById(
            "prenom",
        ) as HTMLInputElement;
        const nomInput = document.getElementById("nom") as HTMLInputElement;
        const emailInput = document.getElementById("email") as HTMLInputElement;

        try {
            const userId = pb.authStore.model?.id;

            if (emailInput && pb.authStore.model?.email) {
                emailInput.value = pb.authStore.model.email;
            }

            const monProfil = await pb
                .collection("utilisateur")
                .getFirstListItem(`compte_id="${userId}"`);

            if (prenomInput)
                prenomInput.value = monProfil.prenom_utilisateur || "";
            if (nomInput) nomInput.value = monProfil.nom_utilisateur || "";
        } catch (error) {
            console.error(
                "Erreur lors de la récupération du profil pour le contact :",
                error,
            );
        }

        const formContact = document.getElementById("form-contact");
        const btnSubmit = document.getElementById("btn-submit");

        formContact?.addEventListener("submit", (e) => {
            e.preventDefault();

            if (btnSubmit) btnSubmit.textContent = "Envoi en cours...";

            setTimeout(async () => {
                alert("Ton message a bien été envoyé à l'équipe !");

                (formContact as HTMLFormElement).reset();

                try {
                    if (emailInput && pb.authStore.model?.email)
                        emailInput.value = pb.authStore.model.email;
                    const monProfil = await pb
                        .collection("utilisateur")
                        .getFirstListItem(
                            `compte_id="${pb.authStore.model?.id}"`,
                        );
                    if (prenomInput)
                        prenomInput.value = monProfil.prenom_utilisateur || "";
                    if (nomInput)
                        nomInput.value = monProfil.nom_utilisateur || "";
                } catch (e) {
                    console.error(e);
                }

                if (btnSubmit) btnSubmit.textContent = "Envoyer";
            }, 800);
        });
    });
</script>
