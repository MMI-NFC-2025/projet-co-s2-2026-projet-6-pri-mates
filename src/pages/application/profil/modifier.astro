---
import Layoutfooter from "../../../layouts/Layout-footer.astro";
import PbImage from "../../../components/PbImage.astro";
import { getUtilisateur } from "../../../../backend/backend.mjs";

// Import des bannières (fichiers locaux)
import imgVille from "../../../assets/image/bannière_ville.webp";
import imgEspace from "../../../assets/image/bannière_espace.webp";
import imgCiel from "../../../assets/image/bannière_ciel_1.webp";
import imgVote from "../../../assets/image/bannière_vote.webp";

// Le serveur charge ça par défaut, mais le script JS va prendre le relais
const Utilisateur = await getUtilisateur();

const bannieres = [
    { id: "ville", nom: "Ville", src: imgVille.src },
    { id: "espace", nom: "Espace", src: imgEspace.src },
    { id: "ciel", nom: "Ciel", src: imgCiel.src },
    { id: "vote", nom: "Vote", src: imgVote.src },
];
---

<Layoutfooter>
    <div class="bg-[#f8f5f0] min-h-screen pb-32 font-sans px-6 pt-8">
        <!-- En-tête -->
        <div class="flex items-center mb-8 max-w-md mx-auto">
            <a
                href="/application/profil"
                class="text-slate-900 bg-white p-2.5 rounded-full shadow-sm"
            >
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="h-6 w-6"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    stroke-width="2"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
                </svg>
            </a>
            <h1 class="text-xl font-bold ml-4 text-slate-900">
                Modifier l'apparence
            </h1>
        </div>

        <form id="form-modifier" class="max-w-md mx-auto flex flex-col gap-8">
            <!-- Photo de profil -->
            <div class="flex flex-col items-center">
                <!-- Ajout de opacity-0 pour cacher la photo d'Axium au chargement -->
                <div
                    class="relative group cursor-pointer opacity-0 transition-opacity duration-300"
                    id="conteneur-photo"
                >
                    <PbImage
                        id="preview-pdp"
                        record={Utilisateur}
                        recordImage={Utilisateur?.photo_profil || ""}
                        class="border-4 border-white h-28 w-28 rounded-full object-cover shadow-sm bg-slate-200 transition-all group-hover:brightness-75"
                    />
                    <div
                        class="absolute inset-0 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity"
                    >
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            class="h-8 w-8 text-white"
                            viewBox="0 0 20 20"
                            fill="currentColor"
                        >
                            <path
                                d="M4 5a2 2 0 00-2 2v8a2 2 0 002 2h12a2 2 0 002-2V7a2 2 0 00-2-2h-1.586a1 1 0 01-.707-.293l-1.121-1.121A2 2 0 0011.172 3H8.828a2 2 0 00-1.414.586L6.293 4.707A1 1 0 015.586 5H4zm6 9a3 3 0 100-6 3 3 0 000 6z"
                            ></path>
                        </svg>
                    </div>
                    <input
                        type="file"
                        id="pdp"
                        name="pdp"
                        accept="image/*"
                        class="hidden"
                    />
                </div>
            </div>

            <!-- Pseudo -->
            <div class="flex flex-col gap-1">
                <label
                    for="pseudo"
                    class="text-sm font-medium text-slate-700 ml-1"
                    >Pseudo (@)</label
                >
                <!-- Retrait du value={Utilisateur?.pseudo} par défaut -->
                <input
                    type="text"
                    id="pseudo"
                    placeholder="Ton pseudo (ex: monpseudo)"
                    class="bg-white border border-slate-200 rounded-xl px-4 py-3 outline-none focus:border-[#a40d1a] transition-all"
                />
            </div>

            <!-- Choix Bannière -->
            <div class="mt-2">
                <label
                    class="text-sm font-medium text-slate-700 ml-1 mb-2 block"
                    >Bannière du profil</label
                >
                <div
                    class="flex overflow-x-auto gap-4 pb-4 snap-x snap-mandatory hide-scrollbar"
                >
                    {
                        bannieres.map((banniere) => (
                            <button
                                type="button"
                                class="snap-center shrink-0 w-48 h-24 relative rounded-xl overflow-hidden border-[3px] border-transparent focus:border-[#a40d1a] transition-all btn-banniere"
                                data-img={banniere.src}
                            >
                                <img
                                    src={banniere.src}
                                    alt={banniere.nom}
                                    class="w-full h-full object-cover"
                                />
                                <div class="absolute bottom-0 inset-x-0 bg-black/60 p-1.5 text-white text-xs text-center">
                                    {banniere.nom}
                                </div>
                            </button>
                        ))
                    }
                </div>
            </div>

            <button
                type="submit"
                id="btn-submit"
                class="mt-4 bg-[#a40d1a] text-white py-3.5 rounded-xl font-bold shadow-md w-full transition-all active:scale-95"
            >
                <span>Enregistrer les modifications</span>
            </button>
        </form>
    </div>
</Layoutfooter>

<style>
    .hide-scrollbar::-webkit-scrollbar {
        display: none;
    }
    .hide-scrollbar {
        -ms-overflow-style: none;
        scrollbar-width: none;
    }
</style>

<script>
    import PocketBase from "pocketbase";
    import { updateProfil } from "../../../../backend/backend.mjs";

    const pb = new PocketBase("https://tacita-pb.charlottemettetal.fr:443");

    document.addEventListener("DOMContentLoaded", async () => {
        // Sécurité
        if (!pb.authStore.isValid) {
            window.location.href = "/application/profil/connexion";
            return;
        }

        const userId = pb.authStore.model?.id;
        const inputPseudo = document.getElementById(
            "pseudo",
        ) as HTMLInputElement;
        const conteneurPhoto = document.getElementById("conteneur-photo");
        const inputPdp = document.getElementById("pdp") as HTMLInputElement;

        // On cible spécifiquement l'image à l'intérieur de ton composant
        const previewPdp = document.querySelector(
            "#conteneur-photo img",
        ) as HTMLImageElement;

        // 🧑‍💻 1. CHARGEMENT DES VRAIES DONNÉES DE L'UTILISATEUR
        try {
            const monProfil = await pb
                .collection("utilisateur")
                .getFirstListItem(`compte_id="${userId}"`);

            // On remplit le champ pseudo avec la vraie valeur
            if (inputPseudo) {
                inputPseudo.value = monProfil.pseudo || "";
            }

            // On va chercher la vraie photo de profil
            if (previewPdp) {
                if (monProfil.photo_profil) {
                    previewPdp.src = pb.files.getUrl(
                        monProfil,
                        monProfil.photo_profil,
                    );
                } else {
                    // Image transparente si pas de photo
                    previewPdp.src =
                        "data:image/gif;base64,R0lGODlhAQABAAD/ACwAAAAAAQABAAACADs=";
                }
            }

            // On fait apparaître le conteneur photo en retirant l'opacité
            if (conteneurPhoto) {
                conteneurPhoto.classList.remove("opacity-0");
            }

            // On fait apparaître le conteneur photo en retirant l'opacité
            if (conteneurPhoto) {
                conteneurPhoto.classList.remove("opacity-0");
            }
        } catch (error) {
            console.error("Erreur lors de la récupération du profil :", error);
            if (conteneurPhoto) conteneurPhoto.classList.remove("opacity-0");
        }

        // 📸 2. GESTION DE LA PHOTO DE PROFIL (Clic et Preview)
        conteneurPhoto?.addEventListener("click", () => inputPdp.click());

        inputPdp?.addEventListener("change", (e) => {
            const file = (e.target as HTMLInputElement).files?.[0];
            if (file && previewPdp) {
                previewPdp.src = URL.createObjectURL(file);
            }
        });

        // 🎨 3. GESTION DES BANNIÈRES (LocalStorage)
        const buttonsBanniere = document.querySelectorAll(".btn-banniere");
        let selectedBannerSrc = localStorage.getItem("user_banner_pref");

        if (selectedBannerSrc) {
            buttonsBanniere.forEach((btn) => {
                if (btn.getAttribute("data-img") === selectedBannerSrc) {
                    btn.classList.add("border-[#a40d1a]");
                }
            });
        }

        buttonsBanniere.forEach((btn) => {
            btn.addEventListener("click", (e) => {
                buttonsBanniere.forEach((b) =>
                    b.classList.remove("border-[#a40d1a]"),
                );
                const target = e.currentTarget as HTMLButtonElement;
                target.classList.add("border-[#a40d1a]");
                selectedBannerSrc = target.getAttribute("data-img");
            });
        });

        // 💾 4. SOUMISSION DU FORMULAIRE
        const formModifier = document.getElementById("form-modifier");
        const btnSubmit = document.getElementById("btn-submit");

        formModifier?.addEventListener("submit", async (e) => {
            e.preventDefault();

            if (btnSubmit)
                btnSubmit.querySelector("span")!.textContent =
                    "Enregistrement en cours...";

            const pseudo = inputPseudo.value;
            const fichierImage = inputPdp.files?.[0] || null;

            // Sauvegarde locale de la bannière
            if (selectedBannerSrc) {
                localStorage.setItem("user_banner_pref", selectedBannerSrc);
            }

            try {
                // On récupère le profil utilisateur pour avoir son ID de collection (et pas son compte_id)
                const profil = await pb
                    .collection("utilisateur")
                    .getFirstListItem(`compte_id="${userId}"`);

                // Enregistrement Pseudo et Photo dans PocketBase
                // Note : Ton script backend s'attend à recevoir { pseudo, photo_profil }
                await updateProfil(profil.id, {
                    pseudo: pseudo,
                    photo_profil: fichierImage,
                });

                alert("Profil et bannière mis à jour !");
                window.location.href = "/application/profil";
            } catch (error) {
                console.error(error);
                alert("Erreur lors de l'enregistrement de ton profil.");
                if (btnSubmit)
                    btnSubmit.querySelector("span")!.textContent =
                        "Enregistrer les modifications";
            }
        });
    });
</script>
