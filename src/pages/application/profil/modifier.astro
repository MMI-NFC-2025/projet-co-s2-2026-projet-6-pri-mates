---
import Layoutfooter from "../../../layouts/Layout-footer.astro";
import PbImage from "../../../components/PbImage.astro";
import { getUtilisateur } from "../../../../backend/backend.mjs";

// Import des bannières prédéfinies (fichiers locaux)
import imgVille from "../../../assets/image/bannière_ville.webp";
import imgEspace from "../../../assets/image/bannière_espace.webp";
import imgCiel from "../../../assets/image/bannière_ciel_1.webp";
import imgVote from "../../../assets/image/bannière_vote.webp";

const Utilisateur = await getUtilisateur();

const bannieresPredefinies = [
    { id: "ville", nom: "Ville", src: imgVille.src },
    { id: "espace", nom: "Espace", src: imgEspace.src },
    { id: "ciel", nom: "Ciel", src: imgCiel.src },
    { id: "vote", nom: "Vote", src: imgVote.src },
];
---

<Layoutfooter>
    <div class="bg-[#f8f5f0] min-h-screen pb-32 font-sans px-6 pt-8">
        <!-- En-tête -->
        <div class="flex items-center mb-8 max-w-md mx-auto">
            <a
                href="/application/profil"
                class="text-slate-900 bg-white p-2.5 rounded-full shadow-sm"
            >
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="h-6 w-6"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    stroke-width="2"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
                </svg>
            </a>
            <h1 class="text-xl font-bold ml-4 text-slate-900">
                Modifier l'apparence
            </h1>
        </div>

        <form id="form-modifier" class="max-w-md mx-auto flex flex-col gap-8">
            <!-- Photo de profil -->
            <div class="flex flex-col items-center">
                <div
                    class="relative group cursor-pointer opacity-0 transition-opacity duration-300"
                    id="conteneur-photo"
                >
                    <PbImage
                        id="preview-pdp"
                        record={Utilisateur}
                        recordImage={Utilisateur?.photo_profil || ""}
                        class="border-4 border-white h-28 w-28 rounded-full object-cover shadow-sm bg-slate-200 transition-all group-hover:brightness-75"
                    />
                    <div
                        class="absolute inset-0 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity"
                    >
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            class="h-8 w-8 text-white"
                            viewBox="0 0 20 20"
                            fill="currentColor"
                        >
                            <path
                                d="M4 5a2 2 0 00-2 2v8a2 2 0 002 2h12a2 2 0 002-2V7a2 2 0 00-2-2h-1.586a1 1 0 01-.707-.293l-1.121-1.121A2 2 0 0011.172 3H8.828a2 2 0 00-1.414.586L6.293 4.707A1 1 0 015.586 5H4zm6 9a3 3 0 100-6 3 3 0 000 6z"
                            ></path>
                        </svg>
                    </div>
                    <input
                        type="file"
                        id="pdp"
                        name="pdp"
                        accept="image/*"
                        class="hidden"
                    />
                </div>
            </div>

            <!-- Pseudo -->
            <div class="flex flex-col gap-1">
                <label
                    for="pseudo"
                    class="text-sm font-medium text-slate-700 ml-1"
                    >Pseudo (@)</label
                >
                <input
                    type="text"
                    id="pseudo"
                    placeholder="Ton pseudo (ex: monpseudo)"
                    class="bg-white border border-slate-200 rounded-xl px-4 py-3 outline-none focus:border-[#a40d1a] transition-all"
                />
            </div>

            <!-- Bannière -->
            <div class="mt-2">
                <label
                    class="text-sm font-medium text-slate-700 ml-1 mb-3 block"
                    >Bannière du profil</label
                >

                <!-- Grille : bannières prédéfinies + bouton upload custom -->
                <div
                    class="flex overflow-x-auto gap-4 pb-4 snap-x snap-mandatory hide-scrollbar"
                >
                    {
                        bannieresPredefinies.map((banniere) => (
                            <button
                                type="button"
                                class="snap-center shrink-0 w-48 h-24 relative rounded-xl overflow-hidden border-[3px] border-transparent transition-all btn-banniere"
                                data-type="predefined"
                                data-img={banniere.src}
                            >
                                <img
                                    src={banniere.src}
                                    alt={banniere.nom}
                                    class="w-full h-full object-cover"
                                />
                                <div class="absolute bottom-0 inset-x-0 bg-black/60 p-1.5 text-white text-xs text-center">
                                    {banniere.nom}
                                </div>
                            </button>
                        ))
                    }

                    <!-- Bouton upload bannière custom -->
                    <button
                        type="button"
                        id="btn-upload-banniere"
                        class="snap-center shrink-0 w-48 h-24 relative rounded-xl overflow-hidden border-[3px] border-dashed border-slate-300 bg-white flex flex-col items-center justify-center gap-1 text-slate-400 hover:border-[#a40d1a] hover:text-[#a40d1a] transition-all"
                    >
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            class="h-7 w-7"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke="currentColor"
                            stroke-width="1.5"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                d="M12 4v16m8-8H4"></path>
                        </svg>
                        <span class="text-xs font-medium">Importer</span>
                        <input
                            type="file"
                            id="input-banniere-custom"
                            accept="image/*"
                            class="hidden"
                        />
                    </button>

                    <!-- Carte preview bannière custom (cachée par défaut) -->
                    <div
                        id="carte-banniere-custom"
                        class="snap-center shrink-0 w-48 h-24 relative rounded-xl overflow-hidden border-[3px] border-transparent transition-all hidden"
                    >
                        <img
                            id="preview-banniere-custom"
                            src=""
                            alt="Bannière custom"
                            class="w-full h-full object-cover"
                        />
                        <div
                            class="absolute bottom-0 inset-x-0 bg-black/60 p-1.5 text-white text-xs text-center"
                        >
                            Ma bannière
                        </div>
                        <!-- Bouton supprimer -->
                        <button
                            type="button"
                            id="btn-supprimer-custom"
                            class="absolute top-1 right-1 bg-black/60 rounded-full p-0.5 text-white hover:bg-[#a40d1a] transition-colors"
                            title="Supprimer"
                        >
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                class="h-4 w-4"
                                fill="none"
                                viewBox="0 0 24 24"
                                stroke="currentColor"
                                stroke-width="2"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    d="M6 18L18 6M6 6l12 12"></path>
                            </svg>
                        </button>
                    </div>
                </div>

                <!-- Indication bannière actuelle depuis PB -->
                <p
                    id="info-banniere-actuelle"
                    class="text-xs text-slate-400 ml-1 mt-1 hidden"
                >
                    Bannière actuelle chargée depuis ton profil
                </p>
            </div>

            <button
                type="submit"
                id="btn-submit"
                class="mt-4 bg-[#a40d1a] text-white py-3.5 rounded-xl font-bold shadow-md w-full transition-all active:scale-95"
            >
                <span>Enregistrer les modifications</span>
            </button>
        </form>
    </div>
</Layoutfooter>

<style>
    .hide-scrollbar::-webkit-scrollbar {
        display: none;
    }
    .hide-scrollbar {
        -ms-overflow-style: none;
        scrollbar-width: none;
    }

    /* Bannière sélectionnée */
    .btn-banniere.selected,
    #carte-banniere-custom.selected {
        border-color: #a40d1a;
    }
</style>

<script>
    import PocketBase from "pocketbase";
    import { updateProfil } from "../../../../backend/backend.mjs";

    const pb = new PocketBase("https://tacita-pb.charlottemettetal.fr:443");

    document.addEventListener("DOMContentLoaded", async () => {
        // ── Sécurité ──────────────────────────────────────────────────────
        if (!pb.authStore.isValid) {
            window.location.href = "/application/profil/connexion";
            return;
        }

        const userId = pb.authStore.model?.id;

        // ── Références DOM ────────────────────────────────────────────────
        const inputPseudo = document.getElementById(
            "pseudo",
        ) as HTMLInputElement;
        const conteneurPhoto = document.getElementById(
            "conteneur-photo",
        ) as HTMLElement;
        const inputPdp = document.getElementById("pdp") as HTMLInputElement;
        const previewPdp = document.querySelector(
            "#conteneur-photo img",
        ) as HTMLImageElement;

        const btnUploadBanniere = document.getElementById(
            "btn-upload-banniere",
        ) as HTMLButtonElement;
        const inputBanniereCustom = document.getElementById(
            "input-banniere-custom",
        ) as HTMLInputElement;
        const carteBanniereCustom = document.getElementById(
            "carte-banniere-custom",
        ) as HTMLElement;
        const previewBanniereCustom = document.getElementById(
            "preview-banniere-custom",
        ) as HTMLImageElement;
        const btnSupprimerCustom = document.getElementById(
            "btn-supprimer-custom",
        ) as HTMLButtonElement;
        const infoBanniereActuelle = document.getElementById(
            "info-banniere-actuelle",
        ) as HTMLElement;

        const buttonsBanniere =
            document.querySelectorAll<HTMLElement>(".btn-banniere");

        // ── État local ────────────────────────────────────────────────────
        let selectedBannerType: "predefined" | "custom" | "pb" = "predefined";
        let selectedBannerSrc: string | null = null; // URL pour les prédéfinies
        let customBannerFile: File | null = null; // Fichier pour la custom
        let profilId: string = "";

        // ── 1. Chargement des données utilisateur ─────────────────────────
        try {
            const monProfil = await pb
                .collection("utilisateur")
                .getFirstListItem(`compte_id="${userId}"`);

            profilId = monProfil.id;

            // Pseudo
            if (inputPseudo) inputPseudo.value = monProfil.pseudo || "";

            // Photo de profil
            if (previewPdp) {
                previewPdp.src = monProfil.photo_profil
                    ? pb.files.getUrl(monProfil, monProfil.photo_profil)
                    : "data:image/gif;base64,R0lGODlhAQABAAD/ACwAAAAAAQABAAACADs=";
            }

            // Bannière stockée dans PocketBase
            if (monProfil.banniere_profil) {
                const urlPb = pb.files.getUrl(
                    monProfil,
                    monProfil.banniere_profil,
                );

                // On affiche la bannière depuis PB dans la carte custom
                previewBanniereCustom.src = urlPb;
                carteBanniereCustom.classList.remove("hidden");
                carteBanniereCustom.classList.add("selected");
                infoBanniereActuelle.classList.remove("hidden");

                selectedBannerType = "pb";
                selectedBannerSrc = urlPb;
            } else {
                // Pas de bannière PB → on relit le localStorage pour les prédéfinies
                const bannerLocal = localStorage.getItem("user_banner_pref");
                if (bannerLocal) {
                    selectedBannerType = "predefined";
                    selectedBannerSrc = bannerLocal;
                    buttonsBanniere.forEach((btn) => {
                        if (btn.getAttribute("data-img") === bannerLocal) {
                            btn.classList.add("selected");
                        }
                    });
                }
            }

            // Afficher le conteneur photo
            conteneurPhoto?.classList.remove("opacity-0");
        } catch (error) {
            console.error("Erreur lors de la récupération du profil :", error);
            conteneurPhoto?.classList.remove("opacity-0");
        }

        // ── 2. Photo de profil ────────────────────────────────────────────
        conteneurPhoto?.addEventListener("click", () => inputPdp.click());

        inputPdp?.addEventListener("change", (e) => {
            const file = (e.target as HTMLInputElement).files?.[0];
            if (file && previewPdp) previewPdp.src = URL.createObjectURL(file);
        });

        // ── 3. Sélection bannière prédéfinie ──────────────────────────────
        buttonsBanniere.forEach((btn) => {
            btn.addEventListener("click", () => {
                // Désélectionner tout
                buttonsBanniere.forEach((b) => b.classList.remove("selected"));
                carteBanniereCustom.classList.remove("selected");

                btn.classList.add("selected");
                selectedBannerType = "predefined";
                selectedBannerSrc = btn.getAttribute("data-img");
                customBannerFile = null;
            });
        });

        // ── 4. Upload bannière custom ─────────────────────────────────────
        btnUploadBanniere?.addEventListener("click", () =>
            inputBanniereCustom.click(),
        );

        inputBanniereCustom?.addEventListener("change", (e) => {
            const file = (e.target as HTMLInputElement).files?.[0];
            if (!file) return;

            customBannerFile = file;
            const objectUrl = URL.createObjectURL(file);

            // Afficher la carte custom
            previewBanniereCustom.src = objectUrl;
            carteBanniereCustom.classList.remove("hidden");
            infoBanniereActuelle.classList.add("hidden");

            // Sélectionner automatiquement la bannière custom
            buttonsBanniere.forEach((b) => b.classList.remove("selected"));
            carteBanniereCustom.classList.add("selected");
            selectedBannerType = "custom";
            selectedBannerSrc = null;
        });

        // Rendre la carte custom sélectionnable au clic
        carteBanniereCustom?.addEventListener("click", (e) => {
            // Ne pas déclencher si c'est le bouton supprimer
            if ((e.target as HTMLElement).closest("#btn-supprimer-custom"))
                return;

            buttonsBanniere.forEach((b) => b.classList.remove("selected"));
            carteBanniereCustom.classList.add("selected");
            selectedBannerType = customBannerFile ? "custom" : "pb";
        });

        // Supprimer la bannière custom
        btnSupprimerCustom?.addEventListener("click", (e) => {
            e.stopPropagation();
            customBannerFile = null;
            inputBanniereCustom.value = "";
            carteBanniereCustom.classList.add("hidden");
            carteBanniereCustom.classList.remove("selected");
            infoBanniereActuelle.classList.add("hidden");
            selectedBannerType = "predefined";
            selectedBannerSrc = null;
        });

        // ── 5. Soumission ─────────────────────────────────────────────────
        const formModifier = document.getElementById("form-modifier");
        const btnSubmit = document.getElementById("btn-submit");
        const spanSubmit = btnSubmit?.querySelector("span");

        formModifier?.addEventListener("submit", async (e) => {
            e.preventDefault();

            if (spanSubmit)
                spanSubmit.textContent = "Enregistrement en cours...";

            const pseudo = inputPseudo.value.trim();
            const fichierPhoto = inputPdp.files?.[0] || null;

            // Sauvegarde locale de la bannière prédéfinie (fallback)
            if (selectedBannerType === "predefined" && selectedBannerSrc) {
                localStorage.setItem("user_banner_pref", selectedBannerSrc);
            }

            try {
                // Récupérer l'id du profil si pas encore en cache
                if (!profilId) {
                    const profil = await pb
                        .collection("utilisateur")
                        .getFirstListItem(`compte_id="${userId}"`);
                    profilId = profil.id;
                }

                // Construire l'objet de mise à jour
                const payload: Record<string, unknown> = {
                    pseudo,
                };

                if (fichierPhoto) payload.photo_profil = fichierPhoto;

                // Bannière custom → on envoie le fichier dans banniere_profil
                if (selectedBannerType === "custom" && customBannerFile) {
                    payload.banniere_profil = customBannerFile;
                }

                // Appel updateProfil (doit accepter un FormData ou un objet avec des File)
                await updateProfil(profilId, payload);

                alert("Profil mis à jour !");
                window.location.href = "/application/profil";
            } catch (error) {
                console.error(error);
                alert("Erreur lors de l'enregistrement de ton profil.");
                if (spanSubmit)
                    spanSubmit.textContent = "Enregistrer les modifications";
            }
        });
    });
</script>
