---
import LayoutFooter from "../../../layouts/Layout-footer.astro";
import PbImage from "../../../components/PbImage.astro";
import { getUtilisateur } from "../../../../backend/backend.mjs";

// Import des bannières
import imgVille from "../../../assets/image/bannière_ville.webp";
import imgEspace from "../../../assets/image/bannière_espace.webp";
import imgCiel from "../../../assets/image/bannière_ciel_1.webp";
import imgVote from "../../../assets/image/bannière_vote.webp";

const Utilisateur = await getUtilisateur();

const bannieres = [
    { id: "ville", nom: "Ville", src: imgVille.src },
    { id: "espace", nom: "Espace", src: imgEspace.src },
    { id: "ciel", nom: "Ciel", src: imgCiel.src },
    { id: "vote", nom: "Vote", src: imgVote.src },
];
---

<LayoutFooter title="Modifier l'apparence">
    <div class="bg-[#f8f5f0] min-h-screen pb-32 font-sans px-6 pt-8">
        <!-- En-tête avec bouton retour -->
        <div class="flex items-center mb-8 max-w-md mx-auto">
            <a
                href="/application/profil"
                class="text-slate-900 bg-white p-2.5 rounded-full shadow-sm hover:bg-slate-100 transition-colors"
            >
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="h-6 w-6"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    stroke-width="2"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
                </svg>
            </a>
            <h1 class="text-xl font-bold ml-4 text-slate-900">
                Modifier l'apparence
            </h1>
        </div>

        <form id="form-modifier" class="max-w-md mx-auto flex flex-col gap-8">
            <!-- SECTION PHOTO DE PROFIL -->
            <div class="flex flex-col items-center">
                <div class="relative group cursor-pointer" id="conteneur-photo">
                    <PbImage
                        id="preview-pdp"
                        record={Utilisateur}
                        recordImage={Utilisateur?.photo_profil || ""}
                        class="border-4 border-white h-28 w-28 rounded-full object-cover shadow-sm bg-slate-200 transition-all group-hover:brightness-75"
                    />

                    <div
                        class="absolute inset-0 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity"
                    >
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            class="h-8 w-8 text-white drop-shadow-md"
                            viewBox="0 0 20 20"
                            fill="currentColor"
                        >
                            <path
                                fill-rule="evenodd"
                                d="M4 5a2 2 0 00-2 2v8a2 2 0 002 2h12a2 2 0 002-2V7a2 2 0 00-2-2h-1.586a1 1 0 01-.707-.293l-1.121-1.121A2 2 0 0011.172 3H8.828a2 2 0 00-1.414.586L6.293 4.707A1 1 0 015.586 5H4zm6 9a3 3 0 100-6 3 3 0 000 6z"
                                clip-rule="evenodd"></path>
                        </svg>
                    </div>

                    <input
                        type="file"
                        id="pdp"
                        name="pdp"
                        accept="image/png, image/jpeg, image/webp"
                        class="hidden"
                    />
                </div>
                <p class="text-xs text-slate-500 mt-2 font-medium">
                    Appuyez pour modifier
                </p>
            </div>

            <!-- SECTION PSEUDO UNIQUEMENT -->
            <div class="flex flex-col gap-2">
                <label
                    for="pseudo"
                    class="text-sm font-bold text-slate-700 ml-1"
                    >Ton Pseudo (@)</label
                >
                <input
                    type="text"
                    id="pseudo"
                    value={Utilisateur?.pseudo}
                    placeholder="Choisis un pseudo..."
                    class="bg-white border border-slate-200 rounded-xl px-4 py-3 outline-none focus:border-[#a40d1a] focus:ring-1 focus:ring-[#a40d1a] transition-all"
                />
            </div>

            <!-- SECTION BANNIÈRE -->
            <div class="mt-2">
                <label class="text-sm font-bold text-slate-700 ml-1 mb-2 block"
                    >Choisis ton ambiance</label
                >
                <div
                    class="flex overflow-x-auto gap-4 pb-4 snap-x snap-mandatory hide-scrollbar"
                >
                    {
                        bannieres.map((banniere) => (
                            <button
                                type="button"
                                class="snap-center shrink-0 w-48 h-24 relative rounded-xl overflow-hidden border-[3px] border-transparent focus:border-[#a40d1a] transition-all btn-banniere"
                                data-banniere={banniere.id}
                            >
                                <img
                                    src={banniere.src}
                                    alt={banniere.nom}
                                    class="w-full h-full object-cover"
                                />
                                <div class="absolute inset-0 bg-black/20 group-hover:bg-transparent transition-colors" />
                                <div class="absolute bottom-0 inset-x-0 bg-black/60 p-1.5 text-white text-xs font-medium text-center backdrop-blur-sm">
                                    {banniere.nom}
                                </div>
                            </button>
                        ))
                    }
                </div>
            </div>

            <!-- Bouton Enregistrer -->
            <button
                type="submit"
                id="btn-submit"
                class="mt-4 bg-[#a40d1a] hover:bg-red-800 text-white px-10 py-3.5 rounded-xl font-bold shadow-md text-lg active:scale-95 transition-all w-full flex justify-center items-center"
            >
                <span>Enregistrer le nouveau look</span>
            </button>
        </form>
    </div>
</LayoutFooter>

<style>
    .hide-scrollbar::-webkit-scrollbar {
        display: none;
    }
    .hide-scrollbar {
        -ms-overflow-style: none;
        scrollbar-width: none;
    }
</style>

<script>
    import PocketBase from "pocketbase";
    import { updateProfil, getImageUrl } from "../../../../backend/backend.mjs";

    const pb = new PocketBase("https://tacita-pb.charlottemettetal.fr:443");

    document.addEventListener("DOMContentLoaded", async () => {
        if (!pb.authStore.isValid) {
            window.location.href = "/application/profil/connexion";
            return;
        }

        const userId = pb.authStore.model?.id;

        // 1. GESTION PHOTO DE PROFIL
        const conteneurPhoto = document.getElementById("conteneur-photo");
        const inputPdp = document.getElementById("pdp") as HTMLInputElement;
        const previewPdp =
            (document.querySelector("#preview-pdp img") as HTMLImageElement) ||
            document.querySelector("#preview-pdp");

        conteneurPhoto?.addEventListener("click", () => inputPdp.click());

        inputPdp?.addEventListener("change", (event) => {
            const target = event.target as HTMLInputElement;
            const file = target.files?.[0];
            if (file && previewPdp) {
                previewPdp.src = URL.createObjectURL(file);
            }
        });

        // 2. GESTION BANNIÈRES
        const buttonsBanniere = document.querySelectorAll(".btn-banniere");
        let selectedBannerId = null;

        buttonsBanniere.forEach((btn) => {
            btn.addEventListener("click", (e) => {
                buttonsBanniere.forEach((b) =>
                    b.classList.remove("border-[#a40d1a]"),
                );
                const target = e.currentTarget as HTMLButtonElement;
                target.classList.add("border-[#a40d1a]");

                selectedBannerId = target.getAttribute("data-banniere");
            });
        });

        // 3. CHARGEMENT INITIAL (Pré-remplissage)
        try {
            const monProfil = await pb
                .collection("utilisateur")
                .getFirstListItem(`compte_id="${userId}"`);

            // Pseudo
            const pseudoInput = document.getElementById(
                "pseudo",
            ) as HTMLInputElement;
            if (pseudoInput && !pseudoInput.value)
                pseudoInput.value = monProfil.pseudo || "";

            // Photo
            if (monProfil.photo_profil && previewPdp) {
                const urlImage = await getImageUrl(
                    monProfil,
                    monProfil.photo_profil,
                );
                if (urlImage) previewPdp.src = urlImage;
            }

            // Bannière
            if (monProfil.banniere) {
                selectedBannerId = monProfil.banniere;
                buttonsBanniere.forEach((btn) => {
                    if (
                        btn.getAttribute("data-banniere") === monProfil.banniere
                    ) {
                        btn.classList.add("border-[#a40d1a]");
                    }
                });
            }
        } catch (e) {
            console.log("Erreur lors du pré-remplissage :", e);
        }

        // 4. SOUMISSION DU FORMULAIRE
        const form = document.getElementById("form-modifier");
        const btnSubmit = document.getElementById("btn-submit");

        form?.addEventListener("submit", async (e) => {
            e.preventDefault();
            if (btnSubmit)
                btnSubmit.querySelector("span")!.textContent =
                    "Enregistrement...";

            const pseudo = (
                document.getElementById("pseudo") as HTMLInputElement
            ).value;
            const fichierImage =
                inputPdp.files && inputPdp.files.length > 0
                    ? inputPdp.files[0]
                    : null;

            // 🚨 NOTRE MOUCHARD 1 🚨
            console.log("ID de la bannière cliquée :", selectedBannerId);

            try {
                const monProfil = await pb
                    .collection("utilisateur")
                    .getFirstListItem(`compte_id="${userId}"`);

                const dataToUpdate = {
                    pseudo: pseudo,
                    photo_profil: fichierImage,
                    banniere: selectedBannerId,
                };

                // 🚨 NOTRE MOUCHARD 2 🚨
                console.log("Données prêtes à être envoyées :", dataToUpdate);

                await updateProfil(monProfil.id, dataToUpdate);

                alert("Apparence mise à jour avec succès !");
                window.location.href = "/application/profil";
            } catch (err: any) {
                console.error("Erreur complète :", err);
                if (err.data?.data?.pseudo?.code === "validation_not_unique") {
                    alert("Ce pseudo est déjà pris par quelqu'un d'autre !");
                } else {
                    alert("Une erreur est survenue lors de la sauvegarde.");
                }
                if (btnSubmit)
                    btnSubmit.querySelector("span")!.textContent =
                        "Enregistrer le nouveau look";
            }
        });
    });
</script>
