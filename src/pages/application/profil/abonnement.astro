---
import LayoutFooter from "../../../layouts/Layout-footer.astro";
---

<LayoutFooter title="Nos offres Premium">
    <div class="bg-[#f8f5f0] min-h-screen pb-32 font-sans px-6 pt-8 md:pt-12">
        
        <div class="flex items-center mb-8 max-w-md md:max-w-2xl mx-auto">
            <a
                href="/application/profil"
                class="text-slate-900 bg-white p-1.5 rounded-full shadow-sm hover:bg-slate-100 transition-colors"
            >
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="h-5 w-5"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    stroke-width="2"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
                </svg>
            </a>
            <h1 class="text-xl md:text-2xl font-bold ml-4 text-slate-900">
                Abonnement
            </h1>
        </div>

        
        <div
            class="max-w-md md:max-w-2xl mx-auto bg-white p-8 md:p-10 rounded-3xl shadow-sm border border-slate-100 flex flex-col items-center"
        >
          
            <div
                class="w-full text-slate-800 text-base md:text-lg mb-8 space-y-6 text-left"
            >
                <p>
                    Découvre nos offres premium. Elles ont les mêmes
                    fonctionnalités, seul le prix et la durée change.
                </p>
                <p>C'est sans engagement et résiliable à tout moment.</p>
            </div>

           
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6 w-full mb-10">
                
                <button
                    type="button"
                    class="btn-offre w-full bg-[var(--creme)] hover:brightness-95 rounded-2xl py-8 px-6 flex flex-col items-center justify-center transition-all border-2 border-transparent focus:outline-none shadow-sm cursor-pointer"
                    data-offre="mensuel"
                >
                    <h2
                        class="font-bold text-black text-xl text-center leading-tight"
                    >
                        Premium<br />1 mois
                    </h2>
                    <p
                        class="text-black text-lg mt-3 text-center leading-tight"
                    >
                        5,99€<br />par mois
                    </p>
                </button>

               
                <button
                    type="button"
                    class="btn-offre w-full bg-[var(--creme)] hover:brightness-95 rounded-2xl py-8 px-6 flex flex-col items-center justify-center transition-all border-2 border-transparent focus:outline-none shadow-sm cursor-pointer"
                    data-offre="annuel"
                >
                    <h2
                        class="font-bold text-black text-xl text-center leading-tight"
                    >
                        Premium<br />à l'année
                    </h2>
                    <p
                        class="text-black text-lg mt-3 text-center leading-tight"
                    >
                        59,99€<br />pour 12 mois
                    </p>
                </button>
            </div>

           
            <button
                type="button"
                id="btn-souscrire"
                class="bg-[#a40d1a] hover:bg-red-800 text-white px-10 py-3.5 rounded-xl font-medium text-sm md:text-base shadow-md transition-all active:scale-95 whitespace-nowrap"
            >
                Essayer 15 jours gratuits
            </button>

        </div>
    </div>
</LayoutFooter>

<script>
    document.addEventListener("DOMContentLoaded", () => {
        const boutonsOffre = document.querySelectorAll(".btn-offre");
        const btnSouscrire = document.getElementById("btn-souscrire");
        let offreSelectionnee = null;

        
        boutonsOffre.forEach((btn) => {
            btn.addEventListener("click", (e) => {
                // On enlève la bordure de toutes les cartes
                boutonsOffre.forEach((b) =>
                    b.classList.remove("border-[#a40d1a]"),
                );

                
                const target = e.currentTarget as HTMLButtonElement;
                target.classList.add("border-[#a40d1a]");

                
                offreSelectionnee = target.getAttribute("data-offre");
            });
        });

        
        btnSouscrire?.addEventListener("click", () => {
            if (!offreSelectionnee) {
                alert("Veuillez sélectionner une offre avant de continuer.");
                return;
            }

            
            alert(
                `Redirection vers la page de paiement pour l'offre : ${offreSelectionnee}`,
            );
        });
    });
</script>
