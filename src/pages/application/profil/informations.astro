---
import LayoutFooter from "../../../layouts/Layout-footer.astro";
import { getUtilisateur } from "../../../../backend/backend.mjs";

const Utilisateur = await getUtilisateur();
---

<LayoutFooter>
    <div class="bg-[#f8f5f0] min-h-screen pb-32 font-sans px-6 pt-8 md:pt-12">
        <div class="flex items-center mb-8 max-w-2xl mx-auto">
            <a
                href="/application/profil"
                class="text-slate-900 bg-white p-2.5 rounded-full shadow-sm hover:bg-slate-100 transition-colors"
            >
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="h-6 w-6"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    stroke-width="2"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
                </svg>
            </a>
            <h1 class="text-xl md:text-2xl font-bold ml-4 text-slate-900">
                Informations personnelles
            </h1>
        </div>

        <div
            class="max-w-2xl mx-auto bg-white p-6 md:p-10 rounded-2xl shadow-sm border border-slate-100"
        >
            <p class="text-slate-500 mb-8 text-sm md:text-base">
                Mets à jour tes informations privées. Ces données ne sont pas
                affichées publiquement sur ton profil.
            </p>

            <form id="form-infos" class="flex flex-col gap-6">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div class="flex flex-col gap-2">
                        <label
                            for="prenom"
                            class="text-sm font-bold text-slate-700 ml-1"
                            >Prénom</label
                        >
                        <input
                            type="text"
                            id="prenom"
                            value={Utilisateur?.prenom_utilisateur}
                            placeholder="Ton prénom"
                            class="bg-[#f8f5f0] border border-slate-200 rounded-xl px-4 py-3.5 outline-none focus:border-[#a40d1a] transition-all"
                        />
                    </div>

                    <div class="flex flex-col gap-2">
                        <label
                            for="nom"
                            class="text-sm font-bold text-slate-700 ml-1"
                            >Nom</label
                        >
                        <input
                            type="text"
                            id="nom"
                            value={Utilisateur?.nom_utilisateur}
                            placeholder="Ton nom"
                            class="bg-[#f8f5f0] border border-slate-200 rounded-xl px-4 py-3.5 outline-none focus:border-[#a40d1a] transition-all"
                        />
                    </div>
                </div>

                <div class="flex flex-col gap-2">
                    <label
                        for="email"
                        class="text-sm font-bold text-slate-700 ml-1"
                        >Adresse e-mail</label
                    >
                    <input
                        type="email"
                        id="email"
                        readonly
                        class="bg-slate-50 text-slate-400 border border-slate-200 rounded-xl px-4 py-3.5 outline-none cursor-not-allowed"
                    />
                    <p class="text-xs text-slate-400 ml-1">
                        L'e-mail est lié à ton compte de connexion actuel.
                    </p>
                </div>

                <div class="mt-4 flex md:justify-end">
                    <button
                        type="submit"
                        id="btn-submit"
                        class="bg-[#a40d1a] hover:bg-red-800 text-white px-10 py-3.5 rounded-xl font-bold shadow-md w-full md:w-auto transition-all active:scale-95"
                    >
                        <span>Enregistrer</span>
                    </button>
                </div>
            </form>
        </div>
    </div>
</LayoutFooter>

<script>
    import PocketBase from "pocketbase";
    const pb = new PocketBase("https://tacita-pb.charlottemettetal.fr:443");

    document.addEventListener("DOMContentLoaded", async () => {
        if (!pb.authStore.isValid) {
            window.location.href = "/application/profil/connexion";
            return;
        }

        const userId = pb.authStore.model?.id;

        const emailInput = document.getElementById("email") as HTMLInputElement;
        if (emailInput && pb.authStore.model?.email) {
            emailInput.value = pb.authStore.model.email;
        }

        const form = document.getElementById("form-infos");
        const btnSubmit = document.getElementById("btn-submit");

        form?.addEventListener("submit", async (e) => {
            e.preventDefault();
            if (btnSubmit)
                btnSubmit.querySelector("span")!.textContent =
                    "Enregistrement...";

            const prenom = (
                document.getElementById("prenom") as HTMLInputElement
            ).value;
            const nom = (document.getElementById("nom") as HTMLInputElement)
                .value;

            const formData = new FormData();
            formData.append("prenom_utilisateur", prenom);
            formData.append("nom_utilisateur", nom);

            try {
                const monProfil = await pb
                    .collection("utilisateur")
                    .getFirstListItem(`compte_id="${userId}"`);
                await pb
                    .collection("utilisateur")
                    .update(monProfil.id, formData);

                try {
                    await pb.collection("users").update(userId, formData);
                    await pb.collection("users").authRefresh();
                } catch (err) {}

                alert("Tes informations personnelles ont été mises à jour !");
                window.location.href = "/application/profil";
            } catch (error) {
                console.error("Erreur PocketBase :", error);
                alert("Erreur lors de la sauvegarde.");
                if (btnSubmit)
                    btnSubmit.querySelector("span")!.textContent =
                        "Enregistrer";
            }
        });
    });
</script>
