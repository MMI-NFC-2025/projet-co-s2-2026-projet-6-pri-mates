---
import LayoutAppli from "../../../layouts/Layout-appli.astro";
import { getPseudo } from "../../../../backend/backend.mjs";

const Utilisateur = await getPseudo();
---

<LayoutAppli>
    <div
        class="bg-[#f8f5f0] min-h-screen flex flex-col pt-12 px-6 pb-20 items-center"
    >
        <div class="w-full max-w-md flex items-center mb-8">
            <a
                href="/application/profil"
                class="text-slate-900 bg-white p-2.5 rounded-full shadow-sm hover:bg-slate-50 transition-colors"
            >
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="h-6 w-6"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    stroke-width="2"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
                </svg>
            </a>
            <h1 class="text-2xl font-bold ml-4 text-slate-900">
                Mes Informations
            </h1>
        </div>

        <form
            id="form-informations"
            class="bg-white p-8 rounded-3xl shadow-sm border-2 border-slate-100 w-full max-w-md flex flex-col gap-6"
        >
            <div class="flex flex-col gap-2">
                <label for="input-pseudo" class="font-bold text-slate-700"
                    >Mon Pseudo</label
                >
                <input
                    type="text"
                    id="input-pseudo"
                    name="pseudo"
                    value={Utilisateur?.pseudo || ""}
                    class="p-4 rounded-xl border-2 border-slate-200 focus:border-red-400 outline-none transition-colors font-semibold text-slate-800"
                />
            </div>

            <div class="flex flex-col gap-2">
                <label for="input-email" class="font-bold text-slate-700"
                    >Mon Email</label
                >
                <input
                    type="email"
                    id="input-email"
                    value={Utilisateur?.email || ""}
                    disabled
                    class="p-4 rounded-xl border-2 border-slate-100 bg-slate-50 text-slate-400 cursor-not-allowed font-medium"
                />
                <span class="text-xs text-slate-400 font-medium"
                    >L'email ne peut pas être modifié.</span
                >
            </div>

            <div class="flex flex-col gap-2 mt-2">
                <label for="input-image" class="font-bold text-slate-700"
                    >Changer ma photo / bannière</label
                >
                <input
                    type="file"
                    id="input-image"
                    name="photo_profil"
                    accept="image/png, image/jpeg, image/webp"
                    class="p-2 file:mr-4 file:py-3 file:px-6 file:rounded-xl file:border-0 file:text-sm file:font-bold file:bg-red-50 file:text-red-800 hover:file:bg-red-100 cursor-pointer text-slate-500 font-medium"
                />
            </div>

            <button
                type="submit"
                id="btn-sauvegarder"
                class="mt-6 bg-red-800 hover:bg-red-900 text-white font-bold text-lg py-4 rounded-xl transition-all shadow-md"
            >
                Mettre à jour
            </button>

            <p id="message-info" class="text-center font-bold text-sm hidden">
            </p>
        </form>
    </div>
</LayoutAppli>

<script>
    import PocketBase from "pocketbase";

    function initialiserPageInfos() {
        const pb = new PocketBase("https://tacita-pb.charlottemettetal.fr");
        const form = document.getElementById("form-informations");
        const btn = document.getElementById("btn-sauvegarder");
        const msg = document.getElementById("message-info");

        if (!form || !btn || !msg) return;

        form.addEventListener("submit", async (e) => {
            e.preventDefault();

            if (!pb.authStore.isValid) {
                afficherMessage(
                    "Tu dois être connecté pour modifier ton profil.",
                    "text-red-500",
                );
                return;
            }

            btn.textContent = "Sauvegarde en cours...";
            btn.classList.add("opacity-50", "pointer-events-none");

            try {
                const formData = new FormData();

                const pseudoValue = (
                    document.getElementById("input-pseudo") as HTMLInputElement
                ).value;
                if (pseudoValue) formData.append("pseudo", pseudoValue);

                const fileInput = document.getElementById(
                    "input-image",
                ) as HTMLInputElement;
                if (fileInput.files && fileInput.files.length > 0) {
                    formData.append("photo_profil", fileInput.files[0]);
                }

                await pb
                    .collection("users")
                    .update(pb.authStore.model!.id, formData);

                afficherMessage(
                    "Profil mis à jour avec succès ! ✨",
                    "text-green-500",
                );
                setTimeout(() => window.location.reload(), 1500);
            } catch (error) {
                console.error(error);
                afficherMessage(
                    "Erreur lors de la sauvegarde. Réessaie.",
                    "text-red-500",
                );
                btn.textContent = "Mettre à jour";
                btn.classList.remove("opacity-50", "pointer-events-none");
            }
        });

        function afficherMessage(texte: string, couleur: string) {
            msg!.textContent = texte;
            msg!.className = `text-center font-bold text-sm block mt-2 ${couleur}`;
        }
    }

    document.addEventListener("DOMContentLoaded", initialiserPageInfos);
    document.addEventListener("astro:page-load", initialiserPageInfos);
</script>
