---
import LayoutAppli from "../../../../layouts/Layout-appli.astro";
import GameList from "../../../../components/cards_jeux.astro";

export function getStaticPaths() {
    return [
        { params: { theme: "alphabet" } },
        { params: { theme: "salutations" } },
        { params: { theme: "nombres" } },
        { params: { theme: "famille" } },
        { params: { theme: "emotions" } },
        { params: { theme: "nourriture" } },
        { params: { theme: "jours-mois" } },
        { params: { theme: "meteo" } },
        { params: { theme: "lieux" } },
    ];
}

const { theme } = Astro.params;
const titreAffiche = theme
    ? theme.charAt(0).toUpperCase() + theme.slice(1)
    : "";
---

<LayoutAppli>
    <div class="bg-[#f8f5f0] min-h-screen pb-32 pt-8">
        <div class="flex items-center mb-8 max-w-md mx-auto px-6">
            <a
                href="/application/jeux"
                class="text-slate-900 bg-white p-2.5 rounded-full shadow-sm hover:bg-slate-50 transition-colors"
            >
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="h-6 w-6"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    stroke-width="2"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
                </svg>
            </a>
            <h1 class="text-xl font-bold ml-4 text-slate-900">
                Thème : {titreAffiche}
            </h1>
        </div>

        <h4 class="text-center font-bold text-slate-800 mb-6">
            Que veux-tu faire ?
        </h4>

        <GameList count={4} themeActuel={theme} />
    </div>
</LayoutAppli>
