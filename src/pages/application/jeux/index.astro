---
import LayoutAppli from "../../../layouts/Layout-appli.astro";


const parcours = [
    {
        id: 1,
        titre: "Les fondations",
        niveaux: [
            {
                id: 1,
                nom: "L'alphabet",
                slug: "alphabet",
                icone: "🔤",
                status: "termine",
                align: "gauche",
            },
            {
                id: 2,
                nom: "Les salutations",
                slug: "salutations",
                icone: "👋",
                status: "actif",
                align: "droite",
            },
            {
                id: 3,
                nom: "Les nombres",
                slug: "nombres",
                icone: "🔢",
                status: "bloque",
                align: "gauche",
            },
        ],
    },
    {
        id: 2,
        titre: "La vie quotidienne",
        niveaux: [
            {
                id: 4,
                nom: "La famille",
                slug: "famille",
                icone: "👪",
                status: "bloque",
                align: "droite",
            },
            {
                id: 5,
                nom: "Les émotions",
                slug: "emotions",
                icone: "🎭",
                status: "bloque",
                align: "gauche",
            },
            {
                id: 6,
                nom: "La nourriture",
                slug: "nourriture",
                icone: "🍎",
                status: "bloque",
                align: "droite",
            },
        ],
    },
    {
        id: 3,
        titre: "Le temps et l'espace",
        niveaux: [
            {
                id: 7,
                nom: "Les jours et mois",
                slug: "jours-mois",
                icone: "📅",
                status: "bloque",
                align: "gauche",
            },
            {
                id: 8,
                nom: "La météo",
                slug: "meteo",
                icone: "☀️",
                status: "bloque",
                align: "droite",
            },
            {
                id: 9,
                nom: "Les lieux",
                slug: "lieux",
                icone: "🗺️",
                status: "bloque",
                align: "gauche",
            },
        ],
    },
];
---

<LayoutAppli>
    <div
        class="bg-[#f8f5f0] min-h-screen pb-32 font-sans overflow-x-hidden relative isolate z-0"
    >
        <div class="pt-10 px-6 max-w-md mx-auto">
            {
                parcours.map((section) => (
                    <div class="mb-24">
                        <h2 class="text-2xl font-bold text-slate-900 mb-10 border-b-2 border-slate-200 pb-2 inline-block relative z-20">
                            {section.titre}
                        </h2>

                        <div class="flex flex-col items-center gap-20 relative">
                            {section.niveaux.map((niveau, index) => {
                                const nextNiveau = section.niveaux[index + 1];
                                const isLineActive =
                                    niveau.status === "termine";
                                const lineColor = isLineActive
                                    ? "#a40d1a"
                                    : "#e2e8f0"; 
                                const positionX =
                                    niveau.align === "gauche"
                                        ? "-translate-x-10"
                                        : "translate-x-10";

                                return (
                                    <div
                                        class={`relative w-24 h-24 shrink-0 z-10 ${positionX}`}
                                    >
                                        <a
                                            href={
                                                niveau.status !== "bloque"
                                                    ? `/application/jeux/${niveau.slug}`
                                                    : "#"
                                            }
                                            class={`
                                            relative z-20 block w-full h-full rounded-full shadow-md border-4 border-[#f8f5f0] transition-transform flex items-center justify-center text-4xl
                                            ${niveau.status !== "bloque" ? "active:scale-95 hover:scale-105 cursor-pointer" : "cursor-not-allowed grayscale"}
                                            ${niveau.status === "termine" ? "bg-[#a40d1a] text-white" : ""}
                                            ${niveau.status === "actif" ? "bg-[#a40d1a] text-white animate-pulse-slow" : ""}
                                            ${niveau.status === "bloque" ? "bg-slate-200 text-slate-400" : ""}
                                        `}
                                        >
                                            <span
                                                class={`flex items-center justify-center w-full h-full ${niveau.status === "bloque" ? "opacity-40" : ""}`}
                                            >
                                                {niveau.icone}
                                            </span>

                                            {niveau.status === "bloque" && (
                                                <div class="absolute -bottom-1 -right-1 bg-white p-2 rounded-full shadow-md text-sm border border-slate-100 flex items-center justify-center w-8 h-8">
                                                    🔒
                                                </div>
                                            )}

                                            {niveau.status === "termine" && (
                                                <div class="absolute -bottom-1 -right-1 bg-yellow-400 p-1.5 rounded-full shadow-md border-2 border-white text-sm flex items-center justify-center w-8 h-8">
                                                    ⭐
                                                </div>
                                            )}
                                        </a>

                                        <div class="absolute top-[115%] left-1/2 -translate-x-1/2 mt-1 z-30 flex justify-center w-[160px] pointer-events-none">
                                            <span
                                                class={`px-4 py-1.5 rounded-full bg-[#f8f5f0] font-bold text-center text-sm shadow-sm border border-slate-100 ${niveau.status === "bloque" ? "text-slate-400" : "text-slate-900"}`}
                                            >
                                                {niveau.nom}
                                            </span>
                                        </div>

                                        {nextNiveau && (
                                            <svg
                                                class={`absolute top-[100%] -z-10 ${niveau.align === "gauche" ? "left-1/2" : "right-1/2"}`}
                                                style="width: 80px; height: 80px; overflow: visible;"
                                                viewBox="0 0 80 80"
                                            >
                                                <path
                                                    d={
                                                        niveau.align ===
                                                        "gauche"
                                                            ? "M 0 0 C 0 40, 80 40, 80 80"
                                                            : "M 80 0 C 80 40, 0 40, 0 80"
                                                    }
                                                    fill="none"
                                                    stroke={lineColor}
                                                    stroke-width="18"
                                                    stroke-linecap="round"
                                                />
                                            </svg>
                                        )}
                                    </div>
                                );
                            })}
                        </div>
                    </div>
                ))
            }
        </div>
    </div>
</LayoutAppli>

<style>
    .animate-pulse-slow {
        animation: pulse-ring 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
    }

    @keyframes pulse-ring {
        0%,
        100% {
            box-shadow: 0 0 0 0 rgba(164, 13, 26, 0.4);
        }
        50% {
            box-shadow: 0 0 0 15px rgba(164, 13, 26, 0);
        }
    }
</style>
