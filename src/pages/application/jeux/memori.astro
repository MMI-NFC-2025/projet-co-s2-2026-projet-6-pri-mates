---
import LayoutAppli from "../../../layouts/Layout-appli.astro";
---

<LayoutAppli>
    <div class="bg-[#f8f5f0] min-h-screen flex flex-col pt-8 px-4 pb-12">
        <div class="flex items-center mb-6 z-10">
            <a
                id="retour-menu"
                href="#"
                class="text-slate-900 bg-white p-2.5 rounded-full shadow-sm hover:bg-slate-50 transition-colors"
            >
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="h-6 w-6"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    stroke-width="2"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
                </svg>
            </a>
            <h1 class="text-xl font-bold ml-4 text-slate-900">Memory</h1>
            <div class="ml-auto flex flex-col items-end">
                <span
                    id="badge-difficulte"
                    class="bg-orange-100 text-orange-700 font-bold px-3 py-1 rounded-full text-xs uppercase tracking-wide mb-1"
                    >...</span
                >
                <span
                    id="compteur-erreurs"
                    class="hidden text-red-600 font-bold text-sm"
                    >Erreurs: 0/10</span
                >
            </div>
        </div>

        <div
            id="message-chargement"
            class="flex-grow flex items-center justify-center text-slate-500 font-bold text-lg"
        >
            Distribution des cartes...
        </div>

        <div
            id="memory-board"
            class="hidden grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4 max-w-4xl mx-auto w-full"
        >
        </div>

        <div
            id="modal-victoire"
            class="hidden fixed inset-0 bg-black/60 items-center justify-center z-50 opacity-0 transition-opacity duration-500"
        >
            <div
                class="bg-white border-4 border-red-300 rounded-xl p-8 max-w-sm w-full mx-4 text-center shadow-2xl transform scale-95 transition-transform duration-500"
                id="modal-content"
            >
                <h2
                    id="titre-modal"
                    class="text-3xl text-red-400 mb-4 font-bold"
                >
                    Bravo ! 🎉
                </h2>
                <p id="texte-modal" class="text-lg text-black mb-8">
                    Tu as trouvé tous les signes !
                </p>

                <div class="flex flex-col gap-4">
                    <button
                        id="btn-rejouer"
                        class="bg-red-300 hover:bg-red-400 text-white font-bold py-3 px-6 rounded-lg transition-colors"
                    >
                        Rejouer
                    </button>
                    <a
                        href="/application/jeux"
                        class="bg-gray-200 hover:bg-gray-300 text-black font-bold py-3 px-6 rounded-lg transition-colors no-underline"
                    >
                        Menu des jeux
                    </a>
                </div>
            </div>
        </div>
    </div>
</LayoutAppli>

<style is:global>
    .perspective-1000 {
        perspective: 1000px;
    }
    .preserve-3d {
        transform-style: preserve-3d;
    }
    .backface-hidden {
        backface-visibility: hidden;
        -webkit-backface-visibility: hidden;
    }
    .rotate-y-180 {
        transform: rotateY(180deg);
    }
    .memory-card.flipped .card-inner {
        transform: rotateY(180deg);
    }
    .trouve {
        opacity: 0.5;
        pointer-events: none;
        transform: scale(0.95);
        transition: all 0.5s ease;
    }
</style>

<script>
    const POCKETBASE_URL = "https://tacita-pb.charlottemettetal.fr";

    let donneesJeu: any[] = [];
    let difficulteGlobale = "moyen";

    let cartes: any[] = [];
    let firstCard: HTMLElement | null = null;
    let secondCard: HTMLElement | null = null;
    let hasFlippedCard = false;
    let lockBoard = true;

    let pairesTrouvees = 0;
    let totalPaires = 0;

    let chronoMemoire: number;
    let erreurs = 0;
    let maxErreurs = 10;
    let jetonExecution = 0;

    async function initialiserJeu() {
        jetonExecution++;
        const monJeton = jetonExecution;
        clearInterval(chronoMemoire);

        const msg = document.getElementById("message-chargement")!;
        const board = document.getElementById("memory-board")!;

        msg.textContent = "Distribution des cartes...";
        msg.classList.replace("text-orange-500", "text-slate-500");
        msg.classList.remove("hidden");

        board.classList.add("hidden");
        board.innerHTML = "";

        const urlParams = new URLSearchParams(window.location.search);
        const themeUrl = (urlParams.get("theme") || "").toLowerCase().trim();
        difficulteGlobale = (urlParams.get("difficulte") || "moyen")
            .toLowerCase()
            .trim();

        const badge = document.getElementById("badge-difficulte");
        if (badge) badge.textContent = difficulteGlobale;

        const lienRetour = document.getElementById(
            "retour-menu",
        ) as HTMLAnchorElement;
        if (lienRetour)
            lienRetour.href = `/application/jeux/difficultes?jeu=memori&theme=${themeUrl}`;

        if (difficulteGlobale === "facile") totalPaires = 4;
        else if (difficulteGlobale === "moyen") totalPaires = 6;
        else if (difficulteGlobale === "difficile") {
            totalPaires = 8;
            const cErr = document.getElementById("compteur-erreurs");
            if (cErr) cErr.classList.remove("hidden");
        }

        try {
            // 🌟 ON REPREND LE FETCH QUI MARCHAIT CHEZ TOI !
            const repI = await fetch(
                `${POCKETBASE_URL}/api/collections/Images/records?perPage=200`,
            );
            if (!repI.ok) throw new Error("Erreur serveur PocketBase");

            const dataI = await repI.json();
            if (jetonExecution !== monJeton) return;

            let imagesFiltrees = dataI.items.filter(
                (i: any) => (i.image || i.Image) && i.nom,
            );

            if (themeUrl) {
                const themeCourt = themeUrl.substring(0, 3);
                const imagesPourTheme = imagesFiltrees.filter((i: any) => {
                    const champLecon = (
                        i.Lecon ||
                        i.lecon ||
                        i.theme ||
                        i.Theme ||
                        ""
                    ).toLowerCase();
                    return champLecon.includes(themeCourt);
                });
                // Si le thème est trouvé, on l'utilise, sinon on prend tout
                if (imagesPourTheme.length > 0) {
                    imagesFiltrees = imagesPourTheme;
                }
            }

            donneesJeu = imagesFiltrees.map((img: any) => {
                const nomFichier = img.image || img.Image;
                return {
                    mot: img.nom.trim(),
                    urlImage: `${POCKETBASE_URL}/api/files/Images/${img.id}/${nomFichier}`,
                };
            });

            donneesJeu = donneesJeu
                .sort(() => Math.random() - 0.5)
                .slice(0, totalPaires);
            totalPaires = donneesJeu.length;

            if (totalPaires > 0) {
                creerCartes();
            } else {
                msg.textContent = "Aucune carte trouvée pour jouer !";
            }
        } catch (error: any) {
            console.error(error);
            msg.textContent = "Erreur de connexion à PocketBase.";
        }
    }

    function creerCartes() {
        cartes = [];
        donneesJeu.forEach((item) => {
            cartes.push({ type: "texte", nom: item.mot, contenu: item.mot });
            cartes.push({
                type: "image",
                nom: item.mot,
                contenu: item.urlImage,
            });
        });
        cartes = cartes.sort(() => Math.random() - 0.5);
        dessinerGrille();
    }

    function dessinerGrille() {
        const board = document.getElementById("memory-board")!;
        const msg = document.getElementById("message-chargement")!;

        board.innerHTML = "";

        cartes.forEach((carte) => {
            const element = document.createElement("div");
            element.className =
                "memory-card w-full h-32 cursor-pointer group perspective-1000 flipped";
            element.dataset.match = carte.nom;

            element.addEventListener("click", () => flipCard(element));

            element.innerHTML = `
                <div class="card-inner relative w-full h-full transition-transform duration-500 preserve-3d pointer-events-none">
                    <div class="card-front absolute w-full h-full bg-red-300 text-white rounded-md flex items-center justify-center border-4 border-white shadow-md backface-hidden">
                        <span class="text-3xl font-bold">?</span>
                    </div>
                    <div class="card-back absolute w-full h-full bg-white text-red-300 rounded-md flex items-center justify-center border-4 border-red-300 shadow-md backface-hidden rotate-y-180 p-2 overflow-hidden flex flex-col">
                        ${
                            carte.type === "texte"
                                ? `<div class="text-xl text-center font-bold break-words w-full px-2">${carte.contenu}</div>`
                                : `<img src="${carte.contenu}" alt="${carte.nom}" class="w-full h-full object-contain p-2 bg-white" />`
                        }
                    </div>
                </div>
            `;
            board.appendChild(element);
        });

        board.classList.remove("hidden");

        lockBoard = true;
        let tempsRestant =
            difficulteGlobale === "difficile"
                ? 2
                : difficulteGlobale === "moyen"
                  ? 3
                  : 4;

        msg.classList.replace("text-slate-500", "text-orange-500");
        msg.textContent = `Mémorise les cartes ! (${tempsRestant}s)`;

        clearInterval(chronoMemoire);
        chronoMemoire = window.setInterval(() => {
            tempsRestant--;
            if (tempsRestant > 0) {
                msg.textContent = `Mémorise les cartes ! (${tempsRestant}s)`;
            } else {
                clearInterval(chronoMemoire);
                msg.classList.add("hidden");

                const cartesDom = document.querySelectorAll(".memory-card");
                cartesDom.forEach((c) => c.classList.remove("flipped"));

                setTimeout(() => {
                    lockBoard = false;
                }, 500);
            }
        }, 1000);
    }

    function flipCard(carte: HTMLElement) {
        if (lockBoard) return;
        if (carte === firstCard) return;
        if (carte.classList.contains("trouve")) return;

        carte.classList.add("flipped");

        if (!hasFlippedCard) {
            hasFlippedCard = true;
            firstCard = carte;
            return;
        }

        secondCard = carte;
        checkForMatch();
    }

    function checkForMatch() {
        let isMatch = firstCard!.dataset.match === secondCard!.dataset.match;
        if (isMatch) disableCards();
        else unflipCards();
    }

    function disableCards() {
        lockBoard = true;
        setTimeout(() => {
            firstCard!.classList.add("trouve");
            secondCard!.classList.add("trouve");

            pairesTrouvees++;
            if (pairesTrouvees === totalPaires) afficherVictoire(true);
            resetBoard();
        }, 800);
    }

    function unflipCards() {
        lockBoard = true;
        setTimeout(() => {
            firstCard!.classList.remove("flipped");
            secondCard!.classList.remove("flipped");
            resetBoard();

            if (difficulteGlobale === "difficile") {
                erreurs++;
                const cErr = document.getElementById("compteur-erreurs");
                if (cErr)
                    cErr.textContent = `Erreurs: ${erreurs}/${maxErreurs}`;
                if (erreurs >= maxErreurs) afficherVictoire(false);
            }
        }, 1200);
    }

    function resetBoard() {
        hasFlippedCard = false;
        lockBoard = false;
        firstCard = null;
        secondCard = null;
    }

    function afficherVictoire(victoire: boolean) {
        const modal = document.getElementById("modal-victoire")!;
        const content = document.getElementById("modal-content")!;
        const titre = document.getElementById("titre-modal")!;
        const texte = document.getElementById("texte-modal")!;

        if (victoire) {
            titre.textContent = "Bravo ! 🎉";
            titre.className = "text-3xl font-bold mb-4 text-green-500";
            texte.textContent =
                difficulteGlobale === "difficile"
                    ? `Trouvées avec ${erreurs} erreur(s) !`
                    : "Tu as trouvé tous les signes !";
        } else {
            titre.textContent = "Aïe... 💥";
            titre.className = "text-3xl font-bold mb-4 text-red-500";
            texte.textContent = "Tu as fait trop d'erreurs !";
        }

        modal.classList.remove("hidden");
        modal.classList.add("flex");
        setTimeout(() => {
            modal.classList.remove("opacity-0");
            content.classList.remove("scale-95");
        }, 50);

        document.getElementById("btn-rejouer")!.onclick = () => {
            modal.classList.add("opacity-0");
            content.classList.add("scale-95");
            setTimeout(() => {
                modal.classList.add("hidden");
                modal.classList.remove("flex");
                pairesTrouvees = 0;
                erreurs = 0;
                const cErr = document.getElementById("compteur-erreurs");
                if (cErr) cErr.textContent = `Erreurs: 0/${maxErreurs}`;
                initialiserJeu();
            }, 500);
        };
    }

    document.addEventListener("DOMContentLoaded", initialiserJeu);
    document.addEventListener("astro:page-load", initialiserJeu);
</script>
