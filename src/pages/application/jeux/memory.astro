---
import LayoutAppli from "../../../layouts/Layout-appli.astro";
---

<LayoutAppli>
    <div class="bg-[#f8f5f0] min-h-screen flex flex-col pt-8 px-4 pb-12">
        <!-- En-tête -->
        <div class="flex items-center mb-6 z-10">
            <a
                id="retour-menu"
                href="#"
                class="text-slate-900 bg-white p-2.5 rounded-full shadow-sm hover:bg-slate-50 transition-colors"
            >
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="h-6 w-6"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    stroke-width="2"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
                </svg>
            </a>
            <h1 class="text-xl font-bold ml-4 text-slate-900">Memory</h1>
            <div class="ml-auto flex flex-col items-end">
                <span
                    id="badge-difficulte"
                    class="bg-orange-100 text-orange-700 font-bold px-3 py-1 rounded-full text-xs uppercase tracking-wide mb-1"
                    >...</span
                >
                <span
                    id="compteur-erreurs"
                    class="hidden text-red-600 font-bold text-sm"
                    >Erreurs: 0/10</span
                >
            </div>
        </div>

        <div
            id="message-chargement"
            class="flex-grow flex items-center justify-center text-slate-500 font-bold"
        >
            Distribution des cartes...
        </div>

        <!-- Grille du Memory -->
        <div
            id="grille-memory"
            class="hidden w-full max-w-md mx-auto perspective"
        >
            <!-- Les cartes seront injectées ici par Javascript -->
        </div>

        <!-- Écran de fin -->
        <div
            id="ecran-fin"
            class="fixed inset-0 bg-white/95 z-50 hidden flex-col items-center justify-center p-6 text-center"
        >
            <h2 id="titre-fin" class="text-4xl font-bold text-green-600 mb-4">
                Bravo ! 🎉
            </h2>
            <p id="texte-fin" class="text-xl text-slate-700 font-medium mb-8">
                Tu as trouvé toutes les paires !
            </p>
            <a
                id="btn-rejouer"
                href="#"
                class="w-full max-w-xs bg-slate-200 text-slate-800 hover:bg-slate-300 font-bold py-4 rounded-xl mb-4 transition-colors"
                >Rejouer ce niveau</a
            >
            <a
                href="/application/jeux"
                class="w-full max-w-xs bg-red-800 text-white hover:bg-rose-950 font-bold py-4 rounded-xl transition-colors"
                >Retour aux jeux</a
            >
        </div>
    </div>
</LayoutAppli>

<style>
    /* CSS MAGIQUE POUR L'EFFET 3D DE LA CARTE */
    .perspective {
        perspective: 1000px;
    }
    .preserve-3d {
        transform-style: preserve-3d;
        transition: transform 0.5s cubic-bezier(0.4, 0.2, 0.2, 1);
    }
    .backface-hidden {
        backface-visibility: hidden;
        -webkit-backface-visibility: hidden; /* Important pour les téléphones (iOS) */
    }
    .rotate-y-180 {
        transform: rotateY(180deg);
    }

    /* Classe ajoutée par JS pour retourner la carte */
    .flipped .preserve-3d {
        transform: rotateY(180deg);
    }

    /* Classe ajoutée pour faire disparaître la carte doucement */
    .trouve {
        opacity: 0;
        pointer-events: none;
        transform: scale(0.9);
        transition: all 0.5s ease;
    }
</style>

<script>
    const POCKETBASE_URL = "https://tacita-pb.charlottemettetal.fr";

    let donneesJeu: any[] = [];
    let difficulteGlobale = "moyen";

    let cartes: any[] = [];
    let carteRetournee1: HTMLElement | null = null;
    let carteRetournee2: HTMLElement | null = null;
    let pairesTrouvees = 0;
    let totalPaires = 0;
    let verrouillageGrille = true;

    let chronoMemoire: number;
    let erreurs = 0;
    let maxErreurs = 10;

    // 🌟 Sécurité pour empêcher le jeu de se charger 2 fois
    let jeuEnCoursDeChargement = false;

    function simplifierTexte(texte: string): string {
        if (!texte) return "";
        return texte
            .toLowerCase()
            .normalize("NFD")
            .replace(/[\u0300-\u036f]/g, "")
            .replace(/[^a-z0-9]/g, "");
    }

    async function initialiserJeu() {
        if (jeuEnCoursDeChargement) return;
        jeuEnCoursDeChargement = true;

        clearInterval(chronoMemoire);

        const msg = document.getElementById("message-chargement")!;
        if (msg) {
            msg.textContent = "Distribution des cartes...";
            msg.className =
                "flex-grow flex items-center justify-center text-slate-500 font-bold text-lg transition-colors";
            msg.classList.remove("hidden");
        }

        const grille = document.getElementById("grille-memory");
        if (grille) {
            grille.classList.add("hidden");
            grille.innerHTML = "";
        }

        const urlParams = new URLSearchParams(window.location.search);
        const themeUrl = (urlParams.get("theme") || "").toLowerCase().trim();
        difficulteGlobale = (urlParams.get("difficulte") || "moyen")
            .toLowerCase()
            .trim();

        document.getElementById("badge-difficulte")!.textContent =
            difficulteGlobale;

        const lienRetour = document.getElementById(
            "retour-menu",
        ) as HTMLAnchorElement;
        if (lienRetour)
            lienRetour.href = `/application/jeux/difficultes?jeu=memory&theme=${themeUrl}`;

        if (difficulteGlobale === "facile") totalPaires = 4;
        else if (difficulteGlobale === "moyen") totalPaires = 6;
        else if (difficulteGlobale === "difficile") {
            totalPaires = 8;
            document
                .getElementById("compteur-erreurs")!
                .classList.remove("hidden");
        }

        try {
            const repQ = await fetch(
                `${POCKETBASE_URL}/api/collections/Questions/records?perPage=200`,
            );
            const dataQ = await repQ.json();
            const repI = await fetch(
                `${POCKETBASE_URL}/api/collections/Images/records?perPage=200`,
            );
            const dataI = await repI.json();

            const isAlp = themeUrl.includes("alp");
            const isSal = themeUrl.includes("sal");

            const questionsDb = dataQ.items.filter((q: any) => {
                const t = (q.theme || "").toLowerCase();
                return (
                    (isAlp && t.includes("alp")) || (isSal && t.includes("sal"))
                );
            });

            const imagesDb = dataI.items.filter((i: any) => {
                const l = (i.Lecon || "").toLowerCase();
                return (
                    (isAlp && l.includes("alp")) || (isSal && l.includes("sal"))
                );
            });

            donneesJeu = questionsDb
                .map((q: any) => {
                    const img = imagesDb.find((i: any) => {
                        const nomBrut = (i.nom || "").toLowerCase().trim();
                        if (!nomBrut) return false;
                        const nomSimple = simplifierTexte(i.nom);
                        const repSimple = simplifierTexte(q.reponse);
                        const questSimple = simplifierTexte(q.question);

                        if (nomSimple === repSimple && nomSimple.length > 0)
                            return true;
                        if (
                            nomSimple.length > 2 &&
                            questSimple.includes(nomSimple)
                        )
                            return true;
                        if (nomBrut.length === 1) {
                            const regex = new RegExp(`\\b${nomBrut}\\b`, "i");
                            if (regex.test(q.question || "")) return true;
                        }
                        return false;
                    });
                    return {
                        mot: img ? img.nom.trim() : null,
                        urlImage: img
                            ? `${POCKETBASE_URL}/api/files/Images/${img.id}/${img.image}`
                            : null,
                        idUnique: img ? img.id : null,
                    };
                })
                .filter((d: any) => d.urlImage !== null && d.mot !== null);

            donneesJeu = donneesJeu
                .sort(() => Math.random() - 0.5)
                .slice(0, totalPaires);
            totalPaires = donneesJeu.length;

            if (totalPaires > 0) {
                creerCartes();
            } else {
                if (msg) msg.textContent = "Aucune donnée trouvée.";
            }
        } catch (error) {
            console.error(error);
            if (msg) msg.textContent = "Erreur de connexion avec PocketBase.";
        }

        jeuEnCoursDeChargement = false; // On déverrouille une fois chargé
    }

    function creerCartes() {
        cartes = [];
        donneesJeu.forEach((item) => {
            cartes.push({
                type: "mot",
                contenu: item.mot,
                matchId: item.idUnique,
            });
            cartes.push({
                type: "image",
                contenu: item.urlImage,
                matchId: item.idUnique,
            });
        });
        cartes = cartes.sort(() => Math.random() - 0.5);
        dessinerGrille();
    }

    function dessinerGrille() {
        const grille = document.getElementById("grille-memory")!;
        grille.innerHTML = "";

        grille.className = "grid gap-3 w-full max-w-md mx-auto perspective";

        if (cartes.length <= 8)
            grille.style.gridTemplateColumns = "repeat(2, 1fr)";
        else if (cartes.length <= 12)
            grille.style.gridTemplateColumns = "repeat(3, 1fr)";
        else grille.style.gridTemplateColumns = "repeat(4, 1fr)";

        cartes.forEach((carte) => {
            const element = document.createElement("div");
            // Les cartes arrivent de face (flipped)
            element.className =
                "relative w-full h-28 cursor-pointer groupe-carte flipped";
            element.dataset.matchId = carte.matchId;
            element.onclick = () => retournerCarte(element);

            element.innerHTML = `
                <div class="preserve-3d w-full h-full relative pointer-events-none">
                    <div class="backface-hidden absolute inset-0 bg-red-800 rounded-xl shadow-md border-2 border-red-900 flex items-center justify-center">
                        <span class="text-white font-bold text-3xl opacity-50">?</span>
                    </div>
                    <div class="backface-hidden rotate-y-180 absolute inset-0 bg-white rounded-xl shadow-md border-2 border-slate-200 flex items-center justify-center p-2 overflow-hidden">
                        ${
                            carte.type === "mot"
                                ? `<span class="text-slate-800 font-bold text-sm md:text-base text-center capitalize break-words w-full">${carte.contenu}</span>`
                                : `<img src="${carte.contenu}" class="w-full h-full object-contain rounded-md" />`
                        }
                    </div>
                </div>
            `;
            grille.appendChild(element);
        });

        grille.classList.remove("hidden");

        verrouillageGrille = true;
        let tempsRestant =
            difficulteGlobale === "difficile"
                ? 2
                : difficulteGlobale === "moyen"
                  ? 3
                  : 4;

        const messageDynamique = document.getElementById("message-chargement")!;
        messageDynamique.classList.replace("text-slate-500", "text-orange-500");
        messageDynamique.textContent = `Mémorise les cartes ! (${tempsRestant}s)`;

        clearInterval(chronoMemoire);
        chronoMemoire = window.setInterval(() => {
            tempsRestant--;

            const msgEl = document.getElementById("message-chargement");

            if (tempsRestant > 0) {
                if (msgEl)
                    msgEl.textContent = `Mémorise les cartes ! (${tempsRestant}s)`;
            } else {
                clearInterval(chronoMemoire);
                if (msgEl) msgEl.classList.add("hidden");

                const grilleActuelle = document.getElementById("grille-memory");
                if (grilleActuelle) {
                    Array.from(grilleActuelle.children).forEach((carteDom) => {
                        (carteDom as HTMLElement).classList.remove("flipped");
                    });
                }

                setTimeout(() => {
                    verrouillageGrille = false;
                }, 500);
            }
        }, 1000);
    }

    function retournerCarte(carte: HTMLElement) {
        if (verrouillageGrille) return;
        if (
            carte.classList.contains("flipped") ||
            carte.classList.contains("trouve")
        )
            return;

        carte.classList.add("flipped");

        if (!carteRetournee1) {
            carteRetournee1 = carte;
        } else {
            carteRetournee2 = carte;
            verifierPaire();
        }
    }

    function verifierPaire() {
        verrouillageGrille = true;

        const match1 = carteRetournee1!.dataset.matchId;
        const match2 = carteRetournee2!.dataset.matchId;

        if (match1 === match2) {
            setTimeout(() => {
                carteRetournee1!.classList.add("trouve");
                carteRetournee2!.classList.add("trouve");
                resetCartes();
                pairesTrouvees++;

                if (pairesTrouvees === totalPaires) {
                    terminerJeu(true);
                }
            }, 800);
        } else {
            setTimeout(() => {
                carteRetournee1!.classList.remove("flipped");
                carteRetournee2!.classList.remove("flipped");
                resetCartes();

                if (difficulteGlobale === "difficile") {
                    erreurs++;
                    const cErreurs =
                        document.getElementById("compteur-erreurs");
                    if (cErreurs)
                        cErreurs.textContent = `Erreurs: ${erreurs}/${maxErreurs}`;

                    if (erreurs >= maxErreurs) terminerJeu(false);
                }
            }, 1200);
        }
    }

    function resetCartes() {
        carteRetournee1 = null;
        carteRetournee2 = null;
        verrouillageGrille = false;
    }

    function terminerJeu(victoire: boolean) {
        const ecranFin = document.getElementById("ecran-fin")!;
        const titreFin = document.getElementById("titre-fin")!;
        const texteFin = document.getElementById("texte-fin")!;

        if (victoire) {
            titreFin.textContent = "Bravo ! 🎉";
            titreFin.className = "text-4xl font-bold text-green-600 mb-4";
            texteFin.textContent =
                difficulteGlobale === "difficile"
                    ? `Tu as mémorisé toutes les paires avec ${erreurs} erreur(s) !`
                    : `Tu as mémorisé toutes les paires !`;
        } else {
            titreFin.textContent = "Aïe... 💥";
            titreFin.className = "text-4xl font-bold text-red-600 mb-4";
            texteFin.textContent =
                "Tu as fait trop d'erreurs. La mémoire, ça s'entraîne !";
        }

        ecranFin.classList.remove("hidden");
        ecranFin.classList.add("flex");

        document.getElementById("btn-rejouer")!.onclick = (e) => {
            e.preventDefault();
            ecranFin.classList.add("hidden");
            ecranFin.classList.remove("flex");
            pairesTrouvees = 0;
            erreurs = 0;
            const cErreurs = document.getElementById("compteur-erreurs");
            if (cErreurs) cErreurs.textContent = `Erreurs: 0/${maxErreurs}`;

            initialiserJeu();
        };
    }

    // 🌟 L'appel direct (Pour les rafraîchissements F5)
    initialiserJeu();

    // 🌟 L'appel Astro (Pour la navigation via les boutons)
    document.addEventListener("astro:page-load", () => {
        initialiserJeu();
    });
</script>
