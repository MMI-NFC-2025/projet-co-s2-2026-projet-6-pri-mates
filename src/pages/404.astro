---
import LayoutApp from "../layouts/Layout-appli.astro";
---

<LayoutApp titre="404 - Tacita">
    <main
        class="min-h-screen flex items-center justify-center px-6 py-16 bg-[#f8f5f0]"
    >
        <section
            class="max-w-xl w-full bg-white rounded-3xl shadow-[0_20px_60px_rgba(164,13,26,0.12)] border border-red-100 p-8 sm:p-12 text-center relative overflow-hidden"
        >
            <div
                class="absolute inset-x-0 top-0 h-2 bg-linear-to-r from-[#a40d1a] via-[#d94b57] to-[#f0b39d]"
            >
            </div>

            <p
                class="text-sm uppercase tracking-[0.35em] text-[#a40d1a] font-bold mb-4"
            >
                Erreur 404
            </p>
            <h1 class="text-4xl sm:text-5xl font-bold text-slate-900 mb-4">
                Page introuvable
            </h1>
            <p class="text-lg text-slate-600 mb-8">
                La page que tu cherches n’existe pas ou a été déplacée.
            </p>

           
                <a
                    href="/application"
                    class="inline-flex items-center justify-center rounded-xl bg-slate-100 px-6 py-3 text-slate-900 font-bold transition-colors hover:bg-slate-200"
                >
                    Aller à l’application
                </a>
            </div>
        </section>
    </main>
</LayoutApp>
