---
import "../style/global.css";
import PbImage from "../components/PbImage.astro";
import {
    getPseudo,
    getProgressionUtilisateur,
} from "../../backend/backend.mjs";

const Utilisateur = await getPseudo();
const stats = getProgressionUtilisateur(Utilisateur);
---


<header
    id="header-banniere"
    class="relative bg-red-100 pb-4 pt-10 bg-cover bg-center transition-all duration-300"
>

    <div
        id="header-overlay"
        class="absolute inset-0 z-0 transition-all duration-300 pointer-events-none"
    >
    </div>

  
    <div class="relative z-10 flex gap-4 items-center">
        
        <h3
            id="header-nom"
            class="m-2 text-slate-900 transition-all duration-300 opacity-0"
        >
            {Utilisateur?.pseudo}
        </h3>

        <p
            id="header-niveau"
            class="font-body text-tinyd p-2 text-slate-800 transition-all duration-300 opacity-0"
        >
            Niveau {stats.niveau} | Jour {stats.jour}
        </p>

        <div
            id="header-img-container"
            class="opacity-0 transition-opacity duration-300"
        >
            <PbImage
                record={Utilisateur}
                recordImage={Utilisateur?.image?.[0] ||
                    Utilisateur?.photo_profil ||
                    ""}
                class="outline-2 outline-offset-2 outline-solid outline-white h-25 w-25 rounded-full object-cover m-2 shrink-0"
            />
        </div>
    </div>
</header>

<script>
    import PocketBase from "pocketbase";
    const pb = new PocketBase("https://tacita-pb.charlottemettetal.fr:443");

    document.addEventListener("DOMContentLoaded", async () => {
        const header = document.getElementById("header-banniere");
        const overlay = document.getElementById("header-overlay");
        const texteNom = document.getElementById("header-nom");
        const texteNiveau = document.getElementById("header-niveau");
        const imgContainer = document.getElementById("header-img-container");


        if (pb.authStore.isValid) {
            try {

                const userId = pb.authStore.model?.id;
                const monProfil = await pb
                    .collection("utilisateur")
                    .getFirstListItem(`compte_id="${userId}"`);

     
        const savedBanner = localStorage.getItem("user_banner_pref");

        if (savedBanner && header && texteNom && texteNiveau && overlay) {
            
            header.style.backgroundImage = `url('${savedBanner}')`;

            
            const imgPath = savedBanner.toLowerCase();

    
            if (
                imgPath.includes("ciel") ||
                imgPath.includes("espace") ||
                imgPath.includes("ville")
            ) {
        
                texteNom.classList.replace("text-slate-900", "text-white");
                texteNiveau.classList.replace(
                    "text-slate-800",
                    "text-slate-100",
                );
                overlay.className =
                    "absolute inset-0 z-0 bg-black/40 transition-all duration-300 pointer-events-none";
            } else if (imgPath.includes("vote")) {
                
                texteNom.classList.add("text-slate-900");
                texteNom.classList.remove("text-white");
                texteNiveau.classList.add("text-slate-800");
                texteNiveau.classList.remove("text-slate-100");
                overlay.className =
                    "absolute inset-0 z-0 bg-white/40 transition-all duration-300 pointer-events-none";
            }
        }
    });
</script>
