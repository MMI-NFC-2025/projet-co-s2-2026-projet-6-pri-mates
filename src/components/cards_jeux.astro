---
const { count = 3 } = Astro.props;
import { getjeux } from "../../backend/backend.mjs";
const Jeux = await getjeux();
---

<div>
    <div class="bg-red-300 text-white rounded-md mx-6 my-6 p-4">
        <div class="text-h4d text-center">Leçon</div>
        <details class="mt-3">
            <summary
                class="cursor-pointer border border-white rounded-full w-10 h-10 mx-auto flex items-center justify-center bg-white text-red-300 font-bold"
            >
                +
            </summary>
            <div class="text-tinyd mt-3">La leçon se compose de questions diverses. Si vous vous trompez, les questions reviennes à la fin de la leçon.</div>
        </details>
    </div>
    <div>
        {
            Jeux.slice(0, count).map((jeu, i) => (
                <div
                    class="bg-red-300 text-white rounded-md mx-6 my-6 p-4"
                    key={jeu.id}
                >
                    <div class="text-h4d text-center">{jeu.jeu}</div>
                    <details class="mt-3">
                        <summary class="cursor-pointer border border-white rounded-full w-10 h-10 mx-auto flex items-center justify-center bg-white text-red-300 font-bold">
                            +
                        </summary>
                        <div class="text-tinyd mt-3">{jeu.description}</div>
                    </details>
                </div>
            ))
        }
    </div>
    <div class="flex justify-center mt-6">
        <a
            href="/"
            class="font-body bg-red-800 hover:bg-rose-950 text-white text-body3d py-4 px-12 rounded-lg"
        >
            Jouer
        </a>
    </div>
</div>
