---
const { count = 3 } = Astro.props;
import { getjeux } from "../../backend/backend.mjs";
const Jeux = await getjeux();
---

<div>
    <div
        class="difficulte-card bg-green-500 text-white rounded-md mx-6 my-6 p-4 cursor-pointer transition-all border-4 border-transparent hover:opacity-80"
        data-difficulte="facile"
    >
        <div class="text-h4d text-center pointer-events-none">Facile</div>
    </div>

    <div
        class="difficulte-card bg-yellow-500 text-white rounded-md mx-6 my-6 p-4 cursor-pointer transition-all border-4 border-transparent hover:opacity-80"
        data-difficulte="moyen"
    >
        <div class="text-h4d text-center pointer-events-none">Moyen</div>
    </div>

    <div
        class="difficulte-card bg-red-500 text-white rounded-md mx-6 my-6 p-4 cursor-pointer transition-all border-4 border-transparent hover:opacity-80"
        data-difficulte="difficile"
    >
        <div class="text-h4d text-center pointer-events-none">Difficile</div>
    </div>

    <div class="flex justify-center mt-6">
        <a
            href="/application/jeux_choisi"
            id="bouton-cest-parti"
            class="font-body bg-gray-400 text-white text-body3d py-4 px-12 rounded-lg cursor-not-allowed pointer-events-none transition-colors duration-300"
        >
            C'est parti
        </a>
    </div>
</div>

document.addEventListener('DOMContentLoaded', () => {
    const cards = document.querySelectorAll('.difficulte-card');
    const boutonCestParti = document.getElementById('bouton-cest-parti');

    // 1. On récupère le nom du jeu depuis l'URL (ex: "quiz", "memory")
    const urlParams = new URLSearchParams(window.location.search);
    const jeuNom = urlParams.get('jeu');

    cards.forEach(card => {
        card.addEventListener('click', () => {
            // ... (Ici tu gardes ton code actuel pour les bordures et couleurs des cards) ...
            
            const difficulte = card.getAttribute('data-difficulte');

            boutonCestParti.classList.remove('bg-gray-400', 'cursor-not-allowed', 'pointer-events-none');
            boutonCestParti.classList.add('bg-red-800', 'hover:bg-rose-950');
            
            // 2. L'AIGUILLAGE : On choisit la bonne page en fonction du nom du jeu
            let urlDestination = "";

            // On utilise .includes() au cas où il y aurait des accents ou des espaces (ex: "le memory")
            if (jeuNom && jeuNom.includes('quiz')) {
                urlDestination = `/application/quiz?difficulte=${difficulte}`;
            } 
            else if (jeuNom && jeuNom.includes('memory')) {
                urlDestination = `/application/memory?difficulte=${difficulte}`;
            } 
            else {
                // Pour ton troisième jeu (remplace "jeu3" par le nom de ton fichier)
                urlDestination = `/application/jeu3?difficulte=${difficulte}`;
            }

            // 3. On applique l'adresse finale au bouton
            boutonCestParti.href = urlDestination;
        });
    });
});
