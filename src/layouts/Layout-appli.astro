---
import "../style/global.css";
import "@fontsource-variable/inter/wght.css";
import FooterAppli from "../components/footer_appli.astro";

import Header from "../components/header-appli.astro";
const { titre = "Tacita - Application" } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{titre}</title>
	</head>
	<body class="flex min-h-screen flex-col pb-40">
		<Header />
		<div class="flex-1 pb-24">
			<slot />
		</div>
		<FooterAppli />
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>
